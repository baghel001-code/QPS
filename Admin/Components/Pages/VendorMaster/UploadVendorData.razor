@inherits QpsPageBase
@using Admin.Components.Shared
@using Admin.Components.UIControls.BaseComponents
@using Application.Interfaces.V1.User
@using ClosedXML.Excel;
@using System.Text.RegularExpressions
@attribute [Authorize]
<MudDialog>
    <DialogContent>
        <div class="row">
            <div class="col-md-8 align-content-end">
                <h5> Upload an Excel file containing Vendor Codes and Email IDs</h5>
            </div>
            <div class="col-md-4 text-end">
                <MudButton Color="Color.Success" OnClick="@Download_Click" Variant="Variant.Filled"> Download Template </MudButton>
            </div>
        </div>
        <MudStack Style="width: 100%">
            <MudForm Model="@_model" @bind-IsValid="_isValid" @bind-IsTouched="_isTouched">
                <MudItem xs="12">
                    <MudFileUpload T="IBrowserFile" Accept=".xlsx,.xls"
                                   @ref="@_fileUpload"
                                   @bind-Files="_model.Files"
                                   For="@(() => _model.Files)"
                                   Hidden="@false"
                                   InputClass="file-upload-input"
                                   ErrorText="@string.Empty"
                                   tabindex="-1"
                                   @ondrop="@ClearDragClass"
                                   @ondragenter="@SetDragClass"
                                   @ondragleave="@ClearDragClass"
                                   @ondragend="@ClearDragClass">
                        <ActivatorContent>
                            <MudPaper Height="300px" Style="background-color: lavenderblush; text-align: center; align-content: center;"
                                      Outlined="true"
                                      Class="@_dragClass">

                                @if (!string.IsNullOrEmpty(_model.Files?.Name))
                                {
                                    <MudChip T="string" Color="Color.Dark" Text="@_model.Files?.Name" />
                                }
                                else
                                {
                                    <MudText Typo="Typo.h6">
                                        <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" />
                                        <br />
                                        Drag and drop files here or click
                                    </MudText>
                                }
                            </MudPaper>
                        </ActivatorContent>
                    </MudFileUpload>

                </MudItem>
                <MudItem>
                    @if (_fileUpload?.ValidationErrors.Any() ?? false)
                    {
                        <MudText Color="Color.Error" Typo="@Typo.caption"> @_fileUpload?.ValidationErrors[0]</MudText>
                    }
                </MudItem>
            </MudForm>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="@OpenFilePickerAsync" Variant="Variant.Filled"> Open file picker </MudButton>
        <MudButton Color="Color.Success" Disabled="@(_model.Files == null)" OnClick="@Upload" Variant="Variant.Filled"> Upload </MudButton>
        <MudButton Color="Color.Warning" Disabled="@(_model.Files == null)" OnClick="@ClearAsync" Variant="Variant.Filled"> Clear </MudButton>
        <MudButton Color="Color.Error" OnClick="@CloseDialog" Variant="Variant.Filled"> Close </MudButton>
    </DialogActions>
</MudDialog>
<Loader IsVisible="@IsLoading" />
@code {
#nullable enable
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }
    public class Model
    {
        public IBrowserFile? Files { get; set; }
    }

    private SelectListReq selectListReq = new();
    private HrpLoginByCodeReq hrpLoginByCodeReq = new();
    public UserDetails User { get; set; } = new();
    public VendorExcel vendorExcel { get; set; } = new();
   
    private Model _model = new();
    private MudFileUpload<IBrowserFile>? _fileUpload;
    private bool _isValid;
    private bool _isTouched;
    bool IsLoading = false;
    private const string FileContent = "this is content";
    private const string DefaultDragClass = "relative rounded-lg border-2 border-dashed pa-4 mt-4 mud-width-full mud-height-full";
    private string _dragClass = DefaultDragClass;
    private List<VendorExcelDetails> vendorRecords = new();
    private List<MasterData> masterDataList = new();
    public List<VendorExcelDataModel> Vendors { get; set; } = new();
    public class VendorValidationResult
    {
        public int RowNumber { get; set; }
        public string VendorCode { get; set; }
        public string EmailId { get; set; }
        public bool IsInvalid { get; set; }
        public List<string> Errors { get; set; } = new();
    }

    public List<int> DuplicateCheckList { get; set; } = new();
    public VendorValidationResult ValidateVendorCode(IXLRow row, List<VendorExcelDataModel> existingVendorCodes)
    {
        var result = new VendorValidationResult();
        var codes = existingVendorCodes.Select(a => a.VENDOR_CODE).ToList();
        result.VendorCode = row.Cell(1).GetValue<string>()?.Trim();
        result.EmailId = row.Cell(2).GetValue<string>()?.Trim();
        result.RowNumber = row.RowNumber();
        // 1. Empty check
        if (string.IsNullOrWhiteSpace(result.VendorCode) || string.IsNullOrWhiteSpace(result.EmailId))
        {
            result.IsInvalid = true;
            result.Errors.Add("Vendor Code or Email is empty");
            return result;
        }

        // 2. Numeric check
        if (!int.TryParse(result.VendorCode, out int vendorCode))
        {
            result.IsInvalid = true;
            result.Errors.Add($"Vendor Code must be numeric");
            return result;
        }

        // 2.1. Duplicate check
        if (DuplicateCheckList.Contains(vendorCode))
        {
            result.IsInvalid = true;
            result.Errors.Add($"Duplicate Vendor Code");
            return result;
        }
        else
        {
            DuplicateCheckList.Add(vendorCode);
        }

        // 3. Duplicate check
        if (existingVendorCodes.Where(a => a.IS_CONFIRMED == true).Any(a => a.VENDOR_CODE.Equals(result.VendorCode, StringComparison.OrdinalIgnoreCase)))//(codes.Contains(vendorCode))
        {
            result.IsInvalid = true;
            result.Errors.Add($"Vendor Code already exists");
            return result;
        }
        // 3.1 Duplicate check
        if (existingVendorCodes.Where(a => a.IS_CONFIRMED == false).Any(a => a.VENDOR_CODE.Equals(result.VendorCode, StringComparison.OrdinalIgnoreCase) && a.EMAIL_IDS.Equals(result.EmailId, StringComparison.OrdinalIgnoreCase)))
        {
            result.IsInvalid = true;
            result.Errors.Add($"Vendor Code and Email id already exists");
            return result;
        }
        // 4. Invalid Email
        if (!IsValidEmail(result.EmailId!))
        {
            result.IsInvalid = true;
            result.Errors.Add($"Invalid email format [{result.EmailId!}]");
        }

        return result;
    }
    public bool IsValidEmail(string email)
    {
        try
        {
            // var addr = new System.Net.Mail.MailAddress(email);
            // return addr.Address == email;
            return Regex.IsMatch(email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$");
        }
        catch
        {
            return false;
        }
    }
    
    private const string UploadFolder = "wwwroot/Excel/VendorOnboard";
    private const string relPath = "/Excel/VendorOnboard";
    private const long MaxFileSize = 1536 * 1024 * 1024; // 1.5GB
    private List<string> fileNames = new();
    private async Task SaveExcelFile()
    {
        if (!_model.Files!.Equals(0))
        {
            // Ensure the directory exists
            var folderPath = Path.Combine(Directory.GetCurrentDirectory(), UploadFolder);
            if (!Directory.Exists(folderPath))
            {
                Directory.CreateDirectory(folderPath);
            }

            // Generate a unique file name to prevent overwriting
            var fileName = Guid.NewGuid() + Path.GetExtension(_model.Files.Name);
            var filePath = Path.Combine(folderPath, fileName);

            // Save the file
            await using var fileStream = new FileStream(filePath, FileMode.Create);
            await _model.Files.OpenReadStream(MaxFileSize).CopyToAsync(fileStream);

            // Update ContentDetails.File_Url with the relative path
            fileNames.Add(Path.Combine("", fileName).Replace("\\", "/"));

        }
    }
    private async void Upload()
    {
        if (_model.Files == null)
        {
            Snackbar.Add("Please select an Excel file to upload.", Severity.Error);
            return;
        }
        // check file type
        if (_model.Files!.ContentType != "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" && _model.Files!.ContentType != "application/vnd.ms-excel")
        {
            Snackbar.Add("Invalid file type. Please upload an Excel file.", Severity.Error);
            return;
        }
        using var stream = _model.Files!.OpenReadStream(long.MaxValue); // allow large files
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        memoryStream.Position = 0;

        using var workbook = new XLWorkbook(memoryStream);
        var worksheet = workbook.Worksheets.First(); // first sheet
        var rows = worksheet.RangeUsed()!.RowsUsed().Skip(1); // skip header row

        vendorRecords.Clear();
        await GetVendors();
        foreach (var row in worksheet.RowsUsed().Skip(1)) // skip header
        {
            var validation = ValidateVendorCode(row, Vendors);
            var record = new VendorExcelDetails
            {
                VENDOR_CODE = validation.VendorCode,
                EMAIL_IDS = validation.EmailId,
                IsInvalid = validation.IsInvalid,
                RowNumber = validation.RowNumber,
                InvalidMessage = string.Join(" | ", validation.Errors)
            };
            vendorRecords.Add(record);
        }

        if (vendorRecords.Count == 0)
        {
            Snackbar.Add("No records found in excel file.", Severity.Warning);
            return;
        }
        await SaveExcelFile();// save excel file on server
        // Updating Records
        IsLoading = true;
        StateHasChanged();
        vendorExcel.EXCEL_FILE = string.Join(",", fileNames);
        vendorExcel.USER_ID = _CurrentUser.UserId ;
        vendorExcel.Data = vendorRecords;
        var result = await ApiMasterService.CallingAPI<GenRes, VendorExcel>(AllApiNames.UPLOAD_VENDOR_EXCEL!, vendorExcel);
        if (result.responseCode.Equals(0))
        {
            await DialogService.ShowMessageBox("Information", $"excel data saved successfully", yesText: "  OK  ");
        }
        else
        {
            await DialogService.ShowMessageBox("Information", $"{result.responseMessage}", yesText: "  OK  ");
        }
        IsLoading = false;
        StateHasChanged();

        MudDialog?.Close();
    }
    private async Task SetUserRoles()
    {
        selectListReq.Id = User!.Id;
        selectListReq.Cmd = CmdNames.Get_Role_Details_On_User_Id;
        var roleDetails = await ApiMasterService.CallingAPI<RoleDetailsOnIdRes, SelectListReq>(AllApiNames.SELECT_ROLEDETAILS_ON_ID, selectListReq);
        if (roleDetails.responseCode == 0)
        {
            User.RoleDetailsList = roleDetails.roleDetails;
        }
        else
        {
            Snackbar.Add(roleDetails.responseMessage!, Severity.Error);
            User.RoleDetailsList = new();
        }
    }
    private void Download_Click()
    {
        NavigationManager.NavigateTo("resources/Template.xlsx", true);
    }
    private void SetDragClass()
        => _dragClass = $"{DefaultDragClass} mud-border-primary";

    private void ClearDragClass()
        => _dragClass = DefaultDragClass;

    private Task OpenFilePickerAsync()
        => _fileUpload?.OpenFilePickerAsync() ?? Task.CompletedTask;

    private Task ClearAsync()
        => _fileUpload?.ClearAsync() ?? Task.CompletedTask;

    private void CloseDialog()
    {
        MudDialog?.Close();
    }

    private async Task GetVendors()
    {
        selectListReq.Id = _CurrentUser.UserId ;
        selectListReq.StrField = "ALL";
        selectListReq.Cmd = CmdNames.Get_Vendor_Excel_Data;
        var res = await ApiMasterService.CallingAPI<GetVendorExcelData, SelectListReq>(AllApiNames.GET_VENDOR_EXCEL_DATA, selectListReq);
        if (res.responseCode == 0)
        {
            if (res.Vendors == null)
            {
                Snackbar.Add("No record found.", Severity.Error);
            }
            else
            {
                Vendors = res.Vendors.OrderBy(a => a.DATE_CREATED).ToList();
            }
        }
        else
        {
            Snackbar.Add(res.responseMessage!, Severity.Error);
        }
    }
}
<style>
    .file-upload-input {
        position: absolute;
        width: 100%;
        height: 100%;
        overflow: hidden;
        z-index: 10;
        opacity: 0;
    }
</style>
