@inherits QpsPageBase
@page "/resetpassword"
@using System.Security.Claims
@using Admin.Components.UIControls.BaseComponents
@using EmailService.Models
@attribute [Authorize(Policy = "VendorMgtAccess")]
@inject IVendorLookupService _vendorLookup
<MudPaper Class="pa-6 mx-auto" MaxWidth="500px" Elevation="4">
    <MudText Typo="Typo.h5" Class="mb-4">Reset Vendor Password</MudText>

    <MudForm @ref="_form" ValidationMode="ValidationMode.Immediate">
        <!-- Vendor Code -->
        <MudTextField @bind-Value="vendorCode"
                      Label="Vendor Code"
                      Required="true"
                      RequiredError="Vendor code is required" />

        <!-- New Password -->
        <MudTextField @bind-Value="Model.NewPassword"
                      Label="New Password"
                      InputType="@(_showNew? InputType.Text: InputType.Password)"
                      Required="true"
                      Immediate="true"
                      OnInput="Revalidate"
                      RequiredError="New password is required"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_showNew? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                      OnAdornmentClick="() => _showNew = !_showNew"
                      HelperText="Minimum 8 chars, uppercase, lowercase, number, special character"
                      For="@(() => Model.NewPassword)"
                      Validation="ValidatePassword" />

        <!-- Confirm Password -->
        <MudTextField @bind-Value="Model.ConfirmPassword"
                      Label="Confirm Password"
                      InputType="@(_showConfirm? InputType.Text: InputType.Password)"
                      Required="true"
                      Immediate="true"
                      OnInput="Revalidate"
                      RequiredError="Please confirm password"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_showConfirm? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                      OnAdornmentClick="() => _showConfirm = !_showConfirm"
                      For="@(() => Model.ConfirmPassword)"
                      Validation="ValidateConfirmPassword" />


        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Class="mt-4"
                   Disabled="@(!_formValid)"
                   OnClick="ChangePWD">
            Change Password
        </MudButton>

    </MudForm>
</MudPaper>

@code {

    private MudForm? _form;
    private bool _formValid;

    private string vendorCode;
    private string NewPassword;
    private bool _showCurrent;
    private bool _showNew;
    private bool _showConfirm;
    private string EmpCode = string.Empty;
    public Vendor _vendor { get; set; } = new();
    private ChangePasswordModel Model = new();
    private int User_Id = 0;


    protected override Task OnUserInitializedAsync()
    {
        User_Id = _CurrentUser.UserId;
        EmpCode = _CurrentUser.UserCode;
        return Task.CompletedTask;
    }
    // Password Policy Validation
    private string ValidatePassword(string password)
    {
        if (string.IsNullOrWhiteSpace(password))
            return "Password is required";

        if (password.Length < 8)
            return "Password must be at least 8 characters";

        if (!password.Any(char.IsUpper))
            return "Password must contain an uppercase letter";

        if (!password.Any(char.IsLower))
            return "Password must contain a lowercase letter";

        if (!password.Any(char.IsDigit))
            return "Password must contain a digit";

        if (!password.Any(ch => "!@#$%^&*()_+-=[]{}|;:'\",.<>/?".Contains(ch)))
            return "Password must contain a special character";
        if (!string.IsNullOrEmpty(Model.ConfirmPassword))
        {
            if (Model.ConfirmPassword != password)
            {
                _formValid = false;
                return "Passwords do not match with confirm password.";
            }
            else
            {
                _formValid = true;
            }

        }

        return null;
    }

    // Confirm Password Validation
    private string ValidateConfirmPassword(string confirm)
    {
        if (confirm != Model.NewPassword)
        {
            _formValid = false;
            return "Passwords do not match";
        }


        _formValid = true;
        return null;

    }

    private async void ChangePWD()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(vendorCode))
            {
                Snackbar.Add($"Vendor code is required", Severity.Error);
                return;
            }

            if (_formValid)
            {
                var result = await _vendorLookup.GetByCodeAsync(vendorCode);
                if (!result.Found)
                {
                    Snackbar.Add($"Vendor [{vendorCode}] not found", Severity.Error);
                    return;
                }
                else
                {
                    _vendor = result.Vendor!;
                    _vendor.PassWord = _passwordHasher.HashPassword(Model.NewPassword);
                    _vendor.Default_Password_Changed = false;
                    var res1 = await ApiMasterService.CallingAPI<GenRes, Vendor>(AllApiNames.SET_VENDOR!, _vendor);
                    if (res1.responseCode.Equals(0))
                    {
                        _vendor = new();

                        Snackbar.Add($"Password for vendor [{vendorCode}] has been reset successfully.", Severity.Success, config =>
                        {
                            config.VisibleStateDuration = 1000;
                        });
                        Model = new();
                        vendorCode = string.Empty;
                        _formValid = false;
                        StateHasChanged();
                    }
                    return;
                }
            }
            else
            {
                Snackbar.Add($"Invalid inputs", Severity.Error);
            }

        }
        catch
        { }

    }

    public class ChangePasswordModel
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }


}
