@using Admin.Components.Pages.UserMaster
@using Admin.Components.Shared
@using Admin.Services
@using Application.Interfaces.V1.User
@using Domain.Records
@using EmailService.Models
@using MudExtensions
@using System.Text.RegularExpressions
@using System.Security.Claims
@inject IInspectionDetailLoader _detailLoader
<MudDialog>
    <DialogContent>
        <MudTable Items="filteredPO" @ref="mudTable" Dense="true">
            <ToolBarContent>
                <MudSpacer />
                <MudTextField T="string" Value="@searchQuery" ValueChanged="OnSearchChanged" Placeholder="Search on PO, Vendor and Vendor Code." Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>INSP-ID/PO</MudTh>
                <MudTh>INSPECTION DATE</MudTh>
                <MudTh>INSPECTION#</MudTh>
                <MudTh>INSPECTOR</MudTh>
                <MudTh>VENDOR</MudTh>
                <MudTh>LOCATION</MudTh>
                <MudTh>CATEGORY</MudTh>
                <MudTh>BUYER</MudTh>
                <MudTh>CONTACT PERSON</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@(context.INSP_ID)/@(context.PO_NUMBER)</MudTd>
                <MudTd>
                    @context.QA_ASSIGNED_DOI.ToString("dd-MMM-yyyy hh:mm tt")
                </MudTd>
                <MudTd>
                    <MudChip T="string"  Variant="Variant.Outlined" Color="Color.Secondary"> @(context.INSPECTION_NO)  </MudChip>
                </MudTd>
                <MudTd>@(context.EMP_NAME) ( @context.INSPECTOR_EMP_CODE )</MudTd>
                <MudTd>@(context.VENDOR_NAME) [@context.VENDOR_CODE]</MudTd>
                <MudTd>@(context.ADDRESS_LINE1), @context.CITY ( @context.PINCODE )</MudTd>
                <MudTd>@(context.CATEGORY)</MudTd>
                <MudTd>@(context.BUYER_NAME) (@context.BUYER_ID)</MudTd>
                <MudTd>@(context.CONTACT_PERSON) (@context.MOBILE_NUMBERS)</MudTd>
                <MudTd>
                    @if (context.QA_ASSIGNED_DOI == DateTime.Now.Date && context.INSPECTOR_EMP_CODE == _CurrentUser.UserCode)
                    {
                        <MudButton OnClick="() => OpenRoleDialog(context.INSP_ID)" StartIcon="@Icons.Material.Filled.Update" Color="Color.Success" Variant="Variant.Text" />
                    }
                </MudTd>
            </RowTemplate>
            <LoadingContent>
                <MudText>Loading...</MudText>
            </LoadingContent>
            <NoRecordsContent>
                <MudText>No records found</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="@pageSizeOptions" />
            </PagerContent>
        </MudTable>
    </DialogContent>

    <DialogActions>
        @*  <MudButton OnClick="Save" Color="Color.Info" Variant="Variant.Filled" Disabled="@isSubmitting">Assign</MudButton> *@
        <MudButton OnClick="CloseDialog" Color="Color.Error" Variant="Variant.Filled">Close</MudButton>
    </DialogActions>
</MudDialog>
<Loader IsVisible="@IsLoading" />

@code {

    [Inject] protected ICurrentUserService _CurrentUser { get; set; } = default!;
    bool isShow;
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }
    public POHeader PO { get; set; } = new();
    [Parameter] public string IDs { get; set; } = "";
    private MudTable<INSPECTIONLISTMODEL> mudTable;
    private int pageSize => 50; // Items per page
    private int[] pageSizeOptions => new[]
  {
        pageSize * 1,
        pageSize * 2,
        pageSize * 3,
        pageSize * 4,
        pageSize * 5
    };
    private List<INSPECTIONLISTMODEL> filteredPO = new();
    private List<INSPECTIONLISTMODEL> pagedPO = new(); // Users to be shown on the current page
    private string searchQuery = string.Empty;
    private int currentPage = 0; // Current page index
    public bool IsMaked { get; set; } = false;

    private bool isFatched { get; set; }

    private MudForm form;
    private bool isSubmitting = false;
    bool IsLoading = false;

    private SelectListReq selectListReq = new();

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(IDs))
        {
            await GetInspections();
            StateHasChanged();
        }
        else
        {
            PO = new();
            isFatched = false;
        }


    }

    private async Task GetInspections()
    {
        selectListReq.Id = 0;
        selectListReq.StrField = IDs;
        selectListReq.Cmd = "";
        var res = await ApiMasterService.CallingAPI<AssignPendingInspectionListResponse, SelectListReq>(AllApiNames.GET_ALL_ASSIGNPENDING_INSPN, selectListReq);
        if (res.responseCode == 0)
        {
            if (res.ListofInspections == null)
            {
                Snackbar.Add("No record found.", Severity.Error);
            }
            else
            {
                pagedPO = res.ListofInspections;
            }
        }
        else
        {
            Snackbar.Add(res.responseMessage!, Severity.Error);
        }

        filteredPO = pagedPO;

    }

    private async Task Reset()
    {
        bool? dres = await DialogService.ShowMessageBox("Confirmation", "Are you sure you want to reset the form ?", yesText: "  Yes!  ", cancelText: "   No   ");
        if (dres == null)
        {
            return;
        }
        else
        {
            PO = new();
            isFatched = false;
            StateHasChanged();
        }
    }

    private void CloseDialog()
    {
        MudDialog?.Close();
    }
    private async Task ShowErrorDialog(string Tital, string message)
    {
        await DialogService.ShowMessageBox(Tital, message);
    }

    private void OnSearchChanged(string searchQuery)
    {
        this.searchQuery = searchQuery;
        FilterPOs(); // Apply search filter
    }
    private void FilterPOs()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredPO = pagedPO; // Show all Users if search is empty
        }
        else
        {
            filteredPO = pagedPO
                .Where(po => po.VENDOR_CODE!.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                       po.VENDOR_NAME!.ToString().Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                       po.PO_NUMBER.ToString().Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                       po.POID!.ToString().Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
                .ToList();

            ApplyPaging(); // Re-apply pagination after search
        }
    }
    private void ApplyPaging()
    {
        var startIndex = currentPage * pageSize;
        filteredPO = filteredPO.Skip(startIndex).Take(pageSize).ToList(); // Paginate the filtered Users
    }

    private async Task OpenRoleDialog(int inspectionId)
    {
        var po = await _detailLoader.LoadAsync(new Domain.Records.InspectionDetailRequest(
            inspectionId, UseQamRegionList: true, FilterInspectionTypeByPoNumber: true));

        await new QaInspectionDialogLauncher().ShowAsync(DialogService, po!, true);
    }
}
