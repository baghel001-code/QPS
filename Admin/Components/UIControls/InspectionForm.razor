                return;
            }
            else
            {
                foreach (var item in fileNames) // now guaranteed non-null
                {
                    try { File.Delete("wwwroot" + item); }
                    catch { /* ignore file delete errors */ }
                }
                await ShowErrorDialog("Error!", res1.responseMessage!);
            }
            StateHasChanged();
        }
        else
        {
            return;
        }

    }

