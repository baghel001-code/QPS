@using Admin.Components.Pages.UserMaster
@using Admin.Components.Shared
@using Application.Interfaces.V1.User
@using Domain.Records
@using EmailService.Models
@using MudExtensions
@using System.Text.RegularExpressions
@using System.Security.Claims
@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.Processing
@using SixLabors.ImageSharp.Formats
@using SixLabors.ImageSharp.Formats.Jpeg
@using SixLabors.ImageSharp.Formats.Png
@using System.IO;
@inject IWebHostEnvironment Env
@implements IAsyncDisposable
@inject IPoSyncService _poSyncService

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Model="_model">
            <MudGrid>
                <MudItem xs="12" md="12">
                    <MudGrid>
                        <MudItem xs="12" md="12">
                            <MudChip T="string" Variant="Variant.Outlined" Color="MudBlazor.Color.Success"> Inspection Request :<b> @inspecitonType </b></MudChip>
                            <MudChip T="string" OnClick="ViewPOIRDetails" Variant="Variant.Filled" Color="MudBlazor.Color.Secondary">View Details [ PO# - @PO.PONumberWithLinkPONumber ] [ IR# - @PO.InspId ] </MudChip>
                            <MudChip T="string" OnClick="() => OpenPoPdf(PO.PONumberWithLinkPONumber)" Variant="Variant.Filled" Color="MudBlazor.Color.Success">DOWNLOAD PO</MudChip>

                            <MudChip T="string" OnClick="ViewReport" Variant="Variant.Outlined" Color="MudBlazor.Color.Info">Report</MudChip>

                            <MudChip T="string" OnClick="async () => await SyncPOdetails()" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Sync" Color="MudBlazor.Color.Success">Sync PO Details</MudChip>

                        </MudItem>


                        @if (_model.InspectionResult == 4)
                        {
                            <!-- Row 1 -->
                            <MudItem xs="12" md="2">
                                <MudSelect T="int" Label="Inspection Result" @bind-Value="_model.InspectionResult" Required="true" Validation="@((int value) => value == 0 ? "Please select a value" : null)">
                                    @foreach (var item in _model.PassFailInspectionResult)
                                    {
                                        <MudSelectItem Value="@item.Master_ID">
                                            @( $"{item.Master_Name}")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <div style="position: relative;">
                                    @if (RgnList.Count > 0)
                                    {
                                        <MudSelectExtended Required="true"
                                                           T="ListItem"
                                                           MultiSelection="true"
                                                           ItemCollection="RgnList"
                                                           SelectedValues="SelectedRgnList"
                                                           SelectedValuesChanged="@(values => Rgn_OnSelectedValuesChanged(values.ToHashSet()))"
                                                           Label="Select Abortive Reasons"
                                                           SearchBox="true"
                                                           SearchBoxAutoFocus="true"
                                                           SelectAll="true"
                                                           Variant="Variant.Outlined"
                                                           Dense="true"
                                                           Clearable="true"
                                                           @ref="ddlRgn"
                                                           OnOpen="Rgn_Open"
                                                           OnClose="Rgn_Close"
                                                           OnClearButtonClick="Rgn_Close"
                                                           AnchorOrigin="Origin.BottomCenter"
                                                           MultiSelectionTextFunc="@(item => SelectedRgnList.Count >1 ? $"{SelectedRgnList.First().LIST_TEXT} + {SelectedRgnList.Count - 1} more" : SelectedRgnList.Count == 1 ? SelectedRgnList.First().LIST_TEXT : string.Empty)"
                                                           ToStringFunc="@(item => item?.LIST_TEXT ?? string.Empty)">
                                        </MudSelectExtended>
                                    }
                                    @if (@SelectedRgnList.Count > 0)
                                    {
                                        if (RgnChipVisible)
                                        {
                                            <MudChip T="string" Style="z-index:9999999;  position: absolute; top: 15px; right: 15px; " Size="MudBlazor.Size.Small" @onclick="CloseRgnDropdown" Color="MudBlazor.Color.Secondary">Apply</MudChip>
                                        }
                                    }
                                </div>
                            </MudItem>

                            <MudItem xs="12" md="2">
                                @if (IsOtherAbortiveReasonVisible)
                                {
                                    <MudTextField T="string" Label="Other Abortive Reason" @bind-Value="_model.OtherAbortiveReason" Required="true" MaxLength="50" />
                                }

                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudTextField T="int" Label="Amount of travelling" @bind-Value="_model.AmtTravelling" Required="true" MaxLength="5" />
                            </MudItem>

                            <!-- Row 2 -->
                            <MudItem xs="12" md="2">
                                <MudSelect T="int" Label="Packing Status (100% Packed)" @bind-Value="_model.PackingStatus" Required="true" Validation="@((int value) => value == 0 ? "Please select a packing status" : null)">
                                    @foreach (var item in _model.YesNoPackingStatus)
                                    {
                                        <MudSelectItem Value="@item.Master_ID">
                                            @( $"{item.Master_Name}")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudTextField Label="No of Bags/Cartons" @bind-Value="_model.NoOfBagsCartonsQty" Required="true" MaxLength="4" Validation="@((int? value) => value == null || value <= 0 ? "Value must be greater than 0" : null)" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudSelect T="int" Label="Unit" @bind-Value="_model.NoOfBagsCartonsUnit" Required="true" Validation="@((int value) => value == 0 ? "Please select a unit" : null)">
                                    @foreach (var item in _model.UnitNoOfBagCarton)
                                    {
                                        <MudSelectItem Value="@item.Master_ID">
                                            @( $"{item.Master_Name}")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" Label="Factory Representative" @bind-Value="_model.NameOfFactoryRepresentative" Required="true" MaxLength="50" />
                            </MudItem>

                        }
                        else
                        {

                            <!-- Row 1 -->
                            <MudItem xs="12" md="2">
                                <MudTextField T="string" Label="GPT NO." @bind-Value="_model.GptNo" Required="true" MaxLength="50" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudSelect T="int" Label="GPT Status" @bind-Value="_model.GptStatus" Required="true" Validation="@((int value) => value == 0 ? "Please select a status" : null)">
                                    @foreach (var item in _model.PassFailGPTStatus)
                                    {
                                        <MudSelectItem Value="@item.Master_ID">
                                            @( $"{item.Master_Name}")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField T="string" Label="Area of fail GPTR" @bind-Value="_model.Area_Of_Fail_GPTR" Required="true" MaxLength="500" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudTextField T="string" Label="If fail(GPT) Approved By" @bind-Value="_model.GptApprovedBy" MaxLength="150" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudDatePicker @bind-Date="_model.GptApprovedDate" Label="Approval Date" Clearable="true" DateFormat="dd/MM/yyyy" />
                            </MudItem>

                            <!-- Row 2 -->
                            <MudItem xs="12" md="2">
                                <MudTextField T="string" Label="Elastic NO." @bind-Value="_model.gptElasticNo" Required="true" MaxLength="50" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudSelect T="int" Label="Elastic Status" @bind-Value="_model.gptElasticStatus" Required="true" Validation="@((int value) => value == 0 ? "Please select a status" : null)">
                                    @foreach (var item in _model.ElasticStatusList)
                                    {
                                        <MudSelectItem Value="@item.Master_ID">
                                            @( $"{item.Master_Name}")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudTextField T="string" Label="If fail(Elastic) Approved By" @bind-Value="_model.gptElasticApprovedBy" MaxLength="150" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudDatePicker @bind-Date="_model.gptElasticApprovedDate" Label="Approval Date" Clearable="true" DateFormat="dd/MM/yyyy" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudTextField Label="No of Bags/Cartons" @bind-Value="_model.NoOfBagsCartonsQty" Required="true" MaxLength="4" Validation="@((int? value) => value == null || value <= 0 ? "Value must be greater than 0" : null)" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudSelect T="int" Label="Unit" @bind-Value="_model.NoOfBagsCartonsUnit" Required="true" Validation="@((int value) => value == 0 ? "Please select a unit" : null)">
                                    @foreach (var item in _model.UnitNoOfBagCarton)
                                    {
                                        <MudSelectItem Value="@item.Master_ID">
                                            @( $"{item.Master_Name}")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <!--Row 3 Zipper-->
                            <MudItem xs="12" md="2">
                                <MudTextField T="string" Label="Zipper Report NO." @bind-Value="_model.ZipperRptNo" Required="true" MaxLength="50" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudSelect T="int" Label="Zipper Status" @bind-Value="_model.ZipperStatus" Required="true" Validation="@((int value) => value == 0 ? "Please select a status" : null)">
                                    @foreach (var item in _model.ZipperStatusList)
                                    {
                                        <MudSelectItem Value="@item.Master_ID">
                                            @( $"{item.Master_Name}")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudTextField T="string" Label="If fail(Zipper) Approved By" @bind-Value="_model.ZipperApprovedBy" MaxLength="150" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudDatePicker @bind-Date="_model.ZipperApprovedDate" Label="Approval Date" Clearable="true" DateFormat="dd/MM/yyyy" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudSelect T="int" Label="Packing Status(100% Packed)" @bind-Value="_model.PackingStatus" Required="true" Validation="@((int value) => value == 0 ? "Please select a packing status" : null)">
                                    @foreach (var item in _model.YesNoPackingStatus)
                                    {
                                        <MudSelectItem Value="@item.Master_ID">
                                            @( $"{item.Master_Name}")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudSelect T="int" Label="Inline Done" @bind-Value="_model.InlineDone" Required="true" Validation="@((int value) => value == 0 ? "Please select a value" : null)">
                                    @foreach (var item in _model.YesNoInlineDone)
                                    {
                                        <MudSelectItem Value="@item.Master_ID">
                                            @( $"{item.Master_Name}")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <!--Row 4 -->
                            <MudItem xs="12" md="2">
                                <MudSelect T="int" Label="Packing List" @bind-Value="_model.PackingList" Required="true" Validation="@((int value) => value == 0 ? "Please select a yes/no." : null)">
                                    @foreach (var item in _model.YesNoPackingList)
                                    {
                                        <MudSelectItem Value="@item.Master_ID">
                                            @( $"{item.Master_Name}")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudDatePicker @bind-Date="_model.PpsReleaseDate" DateFormat="dd/MM/yyyy" Label="PPS Release Date" Required="true" Validation="@((DateTime? d) => d == null ? "PPS Release Date is required" : null)" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudTextField Value="@(_model.PpsExpiryDate?.ToString("dd/MM/yyyy"))" Label="PPS Expiry Date" Required="true" ReadOnly="true" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudDatePicker @bind-Date="_model.MFG_Date" Label="MFG Date" Required="true" DateFormat="dd/MM/yyyy" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudTextField T="string" Label="Season" @bind-Value="_model.Season" Required="true" MaxLength="150" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudSelect T="int" Label="Color Code" @bind-Value="_model.ColorCode" Required="true" Validation="@((int value) => value == 0 ? "Please select a color code" : null)">
                                    <MudSelectItem Value="0">
                                        --Select--
                                    </MudSelectItem>
                                    @foreach (var item in _model.ColorList)
                                    {
                                        <MudSelectItem Value="@item.Master_ID">
                                            @( $"{item.Master_Name}")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <!--Row 5 -->
                            <MudItem xs="12" md="2">
                                <MudTextField Label="Measurement Sample Size" @bind-Value="_model.measurementSampleQty" Required="true" MaxLength="4" Validation="@((int? value) => value == null || value <= 0 ? "Value must be greater than 0" : null)" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudSelect T="int" Label="Measurement" @bind-Value="_model.MeasurementSampleSize" Required="true" Validation="@((int value) => value == 0 ? "Please select a measurement status" : null)">
                                    @foreach (var item in _model.PassFailMeasurementSampleSize)
                                    {
                                        <MudSelectItem Value="@item.Master_ID">
                                            @( $"{item.Master_Name}")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="8">
                                <MudTextField T="string" Label="Fiber Content On PO" @bind-Value="_model.FiberContentOnPo" Required="true" MaxLength="250" />
                            </MudItem>

                            <!--Row 6 -->
                            <MudItem xs="12" md="2">
                                <MudTextField T="string" Label="Fiber Content On Test Report" @bind-Value="_model.FiberContentOnTestReport" Required="true" MaxLength="250" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudTextField T="string" Label="Fiber Content On W/C" @bind-Value="_model.FiberContentOnWc" Required="true" MaxLength="250" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudTextField T="string" Label="GSM On PO" @bind-Value="_model.GsmOnPo" Required="true" MaxLength="150" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudTextField T="string" Label="GSM On Test Report" @bind-Value="_model.GsmOnTestReport" Required="true" MaxLength="150" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudTextField Label="GSM On Bulk" @bind-Value="_model.GsmOnBulk" MaxLength="150" />
                            </MudItem>
                            @if (_CurrentUser.IsQAAdmin || _CurrentUser.IsQAM)
                            {
                                <MudItem xs="12" md="2">
                                    <MudTextField T="string" Label="FIT" @bind-Value="_model.Fit" MaxLength="50" />
                                </MudItem>
                            }
                            else
                            {
                                <MudItem xs="12" md="2">
                                    <MudTextField T="string" Label="FIT" @bind-Value="_model.Fit" Required="true" MaxLength="50" />
                                </MudItem>
                            }


                            <!--Row 7 -->
                            <MudItem xs="12" md="2">
                                <MudTextField Label="Bags/Cartons Check" @bind-Value="_model.NoOfCheck" Required="true" MaxLength="4" Validation="@((int? value) => value == null || value <= 0 ? "Value must be greater than 0" : null)" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudSelect T="int" Label="Unit" @bind-Value="_model.NoOfCheckUnit" Required="true" Validation="@((int value) => value == 0 ? "Please select a unit" : null)">

                                    @foreach (var item in _model.UnitNoOfCheck)
                                    {
                                        <MudSelectItem Value="@item.Master_ID">
                                            @( $"{item.Master_Name}")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            @if (_CurrentUser.IsQAAdmin || _CurrentUser.IsQAM)
                            {
                                <MudItem xs="12" md="2">
                                    <MudTextField Label="Selected Bags/Cartons No." @bind-Value="_model.SelectedBagCartonsNo" MaxLength="100" />
                                </MudItem>
                            }
                            else
                            {
                                <MudItem xs="12" md="2">
                                    <MudTextField Label="Selected Bags/Cartons No." @bind-Value="_model.SelectedBagCartonsNo" Required="true" MaxLength="100" />
                                </MudItem>
                            }

                            <MudItem xs="12" md="2">
                                <MudTextField Label="No of Prepack Check" @bind-Value="_model.NoOfPrepackCheck" Required="true" MaxLength="4" Validation="@((int? value) => value == null || value <= 0 ? "Value must be greater than 0" : null)" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudSelect T="int" Label="Inspection Result" @bind-Value="_model.InspectionResult" Required="true" Validation="@((int value) => value == 0 ? "Please select a value" : null)">
                                    @foreach (var item in _model.PassFailInspectionResult)
                                    {
                                        <MudSelectItem Value="@item.Master_ID">
                                            @( $"{item.Master_Name}")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudSelect T="int" Label="Fail Reason" @bind-Value="_model.Reason_for_fail" Required="true">
                                    <MudSelectItem Value="0">
                                        --Select--
                                    </MudSelectItem>
                                    @foreach (var item in _model.FailReasonList)
                                    {
                                        <MudSelectItem Value="@item.Master_ID">
                                            @( $"{item.Master_Name}")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <!-- Row 8 -->


                            <MudItem xs="12" md="2">
                                <MudTextField Label="Total Qty." @bind-Value="_model.POTotalQuantity" ReadOnly="true" MaxLength="50" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudTextField Label="Offered Qty." @bind-Value="_model.POOfferQuantity" Required="true" MaxLength="7" Validation="@((int? value) => value == null || value <= 0 ? "Value must be greater than 0" : null)" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudTextField Label="Ship Quantity" @bind-Value="_model.OfferedQuantity" Required="true" @onfocusout="DisplayAQL" MaxLength="7" Validation="@((int? value) => value == null || value <= 0 ? "Value must be greater than 0" : null)" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudChip T="string" OnClick="() => ViewAQL()" Variant="Variant.Text" Icon="@Icons.Material.Filled.Info" Color="MudBlazor.Color.Info">Sample Size: <b>@_model.AqlSampleSize</b>  PCS</MudChip>
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudChip T="string" Variant="Variant.Text" Color="MudBlazor.Color.Info">AQL: Major/Minor 2.5/2.5</MudChip>
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudTextField T="string" Label="Workmanship" @bind-Value="_model.Workmanship" Required="true" MaxLength="50" />
                            </MudItem>

                            <!-- Row 8 Conformity-->
                            <MudItem xs="12" md="6">
                                <MudSimpleTable Hover="true" Dense="true" Bordered="true" Striped="true">
                                    <ColGroup>
                                        <col style="width:auto" />
                                        <col style="width:150px" />
                                    </ColGroup>
                                    <thead>
                                        <tr>
                                            <th>Conformity</th>
                                            <th>PASS / FAIL</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>
                                                <MudTextField Label="Size" @bind-Value="_model.conformitySize" Required="true" MaxLength="150" />
                                            </td>
                                            <td>
                                                <MudSelect T="int" Label="" @bind-Value="_model.conformitySizeStatus" Required="true" Validation="@((int value) => value == 0 ? "Please select a value" : null)">
                                                    @*   <MudSelectItem Value="0">
                                                        --Select--
                                                    </MudSelectItem> *@
                                                    @foreach (var item in _model.ConformitySizeStatusList)
                                                    {
                                                        <MudSelectItem Value="@item.Master_ID">
                                                            @( $"{item.Master_Name}")
                                                        </MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Embriodery/Print (Should be as per PPS)</td>
                                            <td>
                                                <MudSelect T="int" Label="" @bind-Value="_model.embroideryPf" Required="true" Validation="@((int value) => value == 0 ? "Please select a value" : null)">
                                                    @*   <MudSelectItem Value="0">
                                                        --Select--
                                                    </MudSelectItem> *@
                                                    @foreach (var item in _model.EmbroideryPFList)
                                                    {
                                                        <MudSelectItem Value="@item.Master_ID">
                                                            @( $"{item.Master_Name}")
                                                        </MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Accessories (Should be as per PPS)</td>
                                            <td>
                                                <MudSelect T="int" Label="" @bind-Value="_model.accessoriesPf" Required="true" Validation="@((int value) => value == 0 ? "Please select a value" : null)">
                                                    @*  <MudSelectItem Value="0">
                                                        --Select--
                                                    </MudSelectItem> *@
                                                    @foreach (var item in _model.AccessoriesPFList)
                                                    {
                                                        <MudSelectItem Value="@item.Master_ID">
                                                            @( $"{item.Master_Name}")
                                                        </MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Barcode Compliances </td>
                                            <td>
                                                <MudSelect T="int" Label="" @bind-Value="_model.barcodePf" Required="true" Validation="@((int value) => value == 0 ? "Please select a value" : null)">
                                                    @*  <MudSelectItem Value="0">
                                                        --Select--
                                                    </MudSelectItem> *@
                                                    @foreach (var item in _model.BarcodePFList)
                                                    {
                                                        <MudSelectItem Value="@item.Master_ID">
                                                            @( $"{item.Master_Name}")
                                                        </MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>No Plastic Tag/Kimble/Tag </td>
                                            <td>
                                                <MudSelect T="int" Label="" @bind-Value="_model.noPlasticPf" Required="true" Validation="@((int value) => value == 0 ? "Please select a value" : null)">
                                                    @*  <MudSelectItem Value="0">
                                                        --Select--
                                                    </MudSelectItem> *@
                                                    @foreach (var item in _model.NoPlasticPFList)
                                                    {
                                                        <MudSelectItem Value="@item.Master_ID">
                                                            @( $"{item.Master_Name}")
                                                        </MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>BOGO / Discount Tag </td>
                                            <td>
                                                <MudSelect T="int" Label="" @bind-Value="_model.bogoPf" Required="true" Validation="@((int value) => value == 0 ? "Please select a value" : null)">
                                                    @*   <MudSelectItem Value="0">
                                                        --Select--
                                                    </MudSelectItem> *@
                                                    @foreach (var item in _model.BogoPFList)
                                                    {
                                                        <MudSelectItem Value="@item.Master_ID">
                                                            @( $"{item.Master_Name}")
                                                        </MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </td>
                                        </tr>
                                    </tbody>
                                </MudSimpleTable>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSimpleTable Hover="true" Dense="true" Bordered="true" Striped="true">
                                    <ColGroup>
                                        <col style="width:auto" />
                                        <col style="width:150px" />
                                    </ColGroup>
                                    <thead>
                                        <tr>
