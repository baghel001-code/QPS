    protected async Task OpenPoPdf(string PoNumber)
    {
        IsLoading = true;
        var POnumbers = PoNumber.Split('~').ToList();
        foreach (var po in POnumbers)
        {
            try
            {

                var (bytes, filename) = await _PODownloadService.TryGetPOPdfAsync(po.Trim());//"5900998021"
                string base64 = Convert.ToBase64String(bytes);
                await JS.InvokeVoidAsync("openPOPdfInNewTab", base64, filename);


            }
            catch (Exception ex)
            {
                Snackbar.Add($"{ex.Message}", Severity.Error, config =>
                {
                    config.VisibleStateDuration = 10000; // milliseconds (10 seconds)
                    config.ShowTransitionDuration = 500;
                    config.HideTransitionDuration = 500;
                });
            }
            finally
            {
                IsLoading = false;
            }
        }

    }


