    private async Task SyncPOdetails(bool askConfirmation = true)
    {
        if (askConfirmation)
        {
            bool? dres = await DialogService.ShowMessageBox("Confirmation", "Do you want to synchronize PO details?",
                yesText: "  Yes  ", cancelText: "   No  ");
            if (dres == null) return;
        }
        try
        {
            isRunning = true;
            progress = 0;

            var progressReporter = new Progress<int>(p => { progress = p; InvokeAsync(StateHasChanged); });
            var result = await _poSyncService.SyncAsync(PO, _CurrentUser.UserId, progressReporter);

            // Manual sync: always show the result.
            // Auto sync: show only when something changed, failed or needs attention.
            bool nothingChanged = result.Success && result.Message == PoSyncMessages.AlreadySynced;
            if (askConfirmation || !nothingChanged)
            {
                string title = result.Issue == PoSyncIssue.None ? "Info" : "Warning";
                await ShowErrorDialog(title, result.Message);
            }
        }
        catch (Exception ex)
        {
            await ShowErrorDialog("Error!", ex.Message!);
        }
        finally
        {
            progress = 0;
            isRunning = false;
            await InvokeAsync(StateHasChanged);
        }

    }


    private void DisplayAQL()
    {
        try
        {
            var offerqty = _model.OfferedQuantity;

            // ✅ Guard: AqlData null check
            if (_model.AqlData == null || !_model.AqlData.Any())
                return;

            // ✅ Fix: .SingleOrDefault() is correct here but add null guard
            var aqlrow = _model.AqlData.FirstOrDefault(a => a.BATCH_SIZE_MIN <= offerqty && a.BATCH_SIZE_MAX >= offerqty);

            if (aqlrow == null)
                return;

            var defect = _model.Defects.SingleOrDefault(d => d.Defects_Id == 1002);
            if (defect == null)
            {
                defect = new InspectionDefectDto { Defects_Id = 1002 };
                _model.Defects.Add(defect);
            }

            defect.Defects = "Allowed";
            defect.Major = aqlrow.AQL_2_5_MAJOR;
            defect.Minor = aqlrow.AQL_2_5_MINOR;

            _model.AqlSampleSize = aqlrow.SAMPLE_SIZE;

            ReOrderDefects();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error calculating AQL: {ex.Message}", Severity.Error);
        }
    }


    private void ReOrderDefects()
    {

        var total = _model.Defects.Where(a => !protectedIds.Contains(a.Defects_Id)).OrderBy(d => d.SNo).ToList();
        int i = 1;// total.Max(a => a.SNo) + 1;
        foreach (var item in total)
        {
            item.SNo = i++;
        }

        var defect = _model.Defects.SingleOrDefault(d => d.Defects_Id == 1001);
        if (defect == null)
        {
            defect = new InspectionDefectDto { Defects_Id = 1001 };
            _model.Defects.Add(defect);
        }
        defect.Defects = "Total";
        defect.Major = total.Sum(a => a.Major);
        defect.Minor = total.Sum(a => a.Minor);
        defect.SNo = i++;

        var itemL = _model.Defects.Where(d => d.Defects_Id == 1002).FirstOrDefault();
        if (itemL != null)
            itemL.SNo = i;

    }
