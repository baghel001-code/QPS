    private void Remove(IBrowserFile item)
    {
        try
        {
            if (item == null)
            {
                Snackbar.Add("Invalid file selected for removal.", Severity.Warning);
                return;
            }

            if (files == null)
            {
                Snackbar.Add("File collection is not initialized.", Severity.Error);
                return;
            }

            bool isRemoved = files.Remove(item);

            if (isRemoved)
            {
                largSizeFiles?.Clear();
                Snackbar.Add($"{item.Name} removed successfully.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"{item.Name} was not found in the file list.", Severity.Warning);
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error while removing file: {ex.Message}", Severity.Error);
        }
    }
