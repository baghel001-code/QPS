@code {
    [Inject] protected IFetchMasterList _fetchMasterList { get; set; } = default!;
    [Inject] protected PODownloadService _PODownloadService { get; set; } = default!;
    [Inject] protected ICurrentUserService _CurrentUser { get; set; } = default!;
    #region Abortive Logic
    //---------Abortive Print
    private async Task ViewReport()
    {
        if (PO != null)
        {
            var parameters = new DialogParameters
            {
                ["InspectId"] = (int)_model.InspectId,
                ["IsPreview"] = true
            };

            if (_model.InspectionResult == 4)
            {
                await DialogService.ShowAsync<InspectionReportAbortiveView>("Abortive Report Preview", parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true });
            }
            else
            {
                await DialogService.ShowAsync<InspectionReportView>("Final Inspection Report", parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true });
            }

        }
        else
            Snackbar.Add("PO data not available.", Severity.Error);


    }


    //----------------------

    private bool IsOtherAbortiveReasonVisible = false;
    private List<ListItem> RgnList = new();
    private HashSet<ListItem> SelectedRgnList = new();
    private MudSelectExtended<ListItem> ddlRgn = new();
    private bool RgnChipVisible = false;
    private int RegionCount = 0;
    private string SelectedRgn => string.Join(",", SelectedRgnList.Where(item => item.IS_SELECTED).Select(item => item.LIST_VALUE));

    private void SetAll()
    {
        try
        {
            GetRgn();

            // ✅ Guard: AbortiveReasonIds null check
            if (string.IsNullOrEmpty(_model.AbortiveReasonIds))
            {
                StateHasChanged();
                return;
            }

            if (_model.AbortiveReasonIds.ToUpper() == "ALL")
            {
                RgnList.ForEach(item => item.IS_SELECTED = true);
            }
            else
            {
                var selectedRgnIds = new HashSet<string>(_model.AbortiveReasonIds.Split(','));
                RgnList.ForEach(item => item.IS_SELECTED = selectedRgnIds.Contains(item.LIST_VALUE!));
            }

            SelectedRgnList = RgnList.Where(d => d.IS_SELECTED).ToHashSet();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error setting abortive reasons: {ex.Message}", Severity.Error);
        }
    }
    //---------------------------AbortiveRgnDDL-----

    private void GetRgn()
    {
        var rgnsltdlist = string.IsNullOrEmpty(_model.AbortiveReasonIds) ? new List<string>() : _model.AbortiveReasonIds.Split(',').ToList();

        var rgnlist = _model.AbortiveReasonList;
        if (rgnlist != null && rgnlist.Count > 0)
        {
            foreach (var item in rgnlist)
            {
                RgnList.Add(new ListItem
                {
                    LIST_TEXT = item.Master_Name,
                    LIST_VALUE = item.Master_ID.ToString(),
                    IS_SELECTED = rgnsltdlist.Contains(item.Master_ID.ToString())
                });
            }
        }
        else
        {
            Snackbar.Add("Abortive Reason List is empty.", Severity.Error);
            RgnList = new();
        }
        StateHasChanged();
    }
    private void Rgn_OnSelectedValuesChanged(HashSet<ListItem> values)
    {
        SelectedRgnList = values;
        if (SelectedRgnList.Any(a => a.LIST_VALUE == "8"))
        {
            IsOtherAbortiveReasonVisible = true;

        }
        else
        {
            IsOtherAbortiveReasonVisible = false;
        }
        StateHasChanged();
    }
    private void Rgn_Open()
    {
        RgnChipVisible = true;
    }
    private async Task Rgn_Close()
    {
        RgnChipVisible = false;
        if (SelectedRgnList.Count > 0)
        {
            // Set IS_SELECTED = true for all selected items
            foreach (var item in SelectedRgnList)
            {
                item.IS_SELECTED = true;
            }
        }
    }
    void CloseRgnDropdown()
    {
        ddlRgn?.CloseMenu();
        RgnChipVisible = false;
    }

    #endregion
    //-----------------------------------------
    #region Autosave logic

    private PeriodicTimer _timer;
    private CancellationTokenSource _cts;
    private Task _backgroundTask;
    private async Task RunAutoSaveAsync(CancellationToken token)
    {
        try
        {
            while (await _timer.WaitForNextTickAsync(token))
            {
                if (!_model.IsComplete)
                {
                    await AutoSaveSafe(token);
                }

            }
        }
        catch (OperationCanceledException ex)
        {
            // ✅ Expected when dialog closes — silently ignore
        }
        catch (ObjectDisposedException ex)
        {
            // ✅ Expected during shutdown — silently ignore
        }
        catch (Exception ex)
        {
            Snackbar.Add($"AutoSave error: {ex.Message}", Severity.Success, config =>
                   {
                       config.VisibleStateDuration = 1000;
                   });
        }
    }
    private async Task AutoSaveSafe(CancellationToken token)
    {
        if (isSubmitting || _model.IsComplete)
        {
            string completedOn = _model.Date_of_Completion?.ToString("dd-MMM-yyyy hh:mm tt") ?? "N/A";

            Snackbar.Add(
                $"Inspection data was already completed and submitted on {completedOn}.",
                Severity.Info,
                config =>
                {
                    config.VisibleStateDuration = 3000;
                });

            return;

        }

        try
        {
            isSubmitting = true;

            if (!_model.IsComplete && isSelfInspector)
            {
                // Don't autosave if form is essentially empty
                // Check at least one meaningful field is filled
                bool hasMinimumData =
                    _model.InspectionResult > 0 || !string.IsNullOrEmpty(_model.GptNo) || !string.IsNullOrEmpty(_model.Season) || _model.OfferedQuantity > 0;

                if (!hasMinimumData)
                {
                    // Form hasn't been touched yet — skip autosave
                    Snackbar.Add("Waiting for input before autosave...",
                        Severity.Info, config =>
                        {
                            config.VisibleStateDuration = 1000;
                        });
                    return;
                }
                _model.UserId = _CurrentUser.UserId;// Set the CREATED BY
                _model.InspectionId = PO.InspId;
                _model.InspectorCode = _CurrentUser.UserCode;
                _model.AbortiveReasonIds = SelectedRgn;

                // ✅ Safe clone — _model.Defects is never touched
                var modelToSave = _model.CloneForAutoSave(protectedIds: protectedIds);

                var res1 = await ApiMasterService.CallingAPI<GenRes, InspectionModel>(AllApiNames.SAVE_INSPECT_DATA!, modelToSave);
                if (res1.responseCode.Equals(0))
                {
                    _model.InspectId = res1.recordId;
                    Snackbar.Add("Changes saved.", Severity.Success, config =>
                    {
                        config.VisibleStateDuration = 500;
                    });
                }
                else
                {
                    Snackbar.Add($"Changes not saved. {res1.responseMessage!}", Severity.Error, config =>
                    {
                        config.VisibleStateDuration = 5000;
                    });
                }
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_cts != null && !_cts.IsCancellationRequested) // ← add this check
        {
            try
            {
                _cts.Cancel();
                if (_backgroundTask != null)
                    await _backgroundTask;
            }
            catch (OperationCanceledException) { }
            finally  // ← move cleanup to finally so it always runs
            {
                _timer?.Dispose();
                _cts?.Dispose();
                _timer = null;
                _cts = null;
                _backgroundTask = null; // ← null it out for GC, no Dispose() needed

            }
        }
    }

    #endregion
    //------------------------------------------
    #region Reset logic
    private async Task Reset()
    {
        try
        {
            bool? dres = await DialogService.ShowMessageBox(
                "Confirmation",
                "Do you want to reset Inspection details?",
                yesText: "Yes",
                cancelText: "No");

            // User clicked No or closed dialog
            if (dres != true)
                return;

            if (_model == null)
            {
                Snackbar.Add("Inspection data not found.", Severity.Error);
                return;
            }

            // Reset values
            _model.IsComplete = false;
            _model.Date_of_Completion = null;
            _model.IsResetByAdmin = true;
            _model.UserId = _CurrentUser.UserId;
            _model.InspectionId = PO?.InspId ?? 0;


            var res1 = await ApiMasterService.CallingAPI<GenRes, InspectionModel>(
                AllApiNames.SAVE_INSPECT_DATA!,
                _model);

            if (res1 != null && res1.responseCode == 0)
            {
                var _attFiles = _model.TestReportAttachment?.Split(',').ToList();

                if (_attFiles != null)
                {
                    foreach (var item in _attFiles)
                    {
                        try
                        {
                            var physicalPath = Path.Combine(Env.WebRootPath, item.TrimStart('/', '\\').Replace('/', '\\'));

                            if (File.Exists(physicalPath))
                                File.Delete(physicalPath);
                        }
                        catch { /* ignore file delete errors */ }
                    }
                }

                var _attFFiles = _model.GenAttachmentFirst?.Split(',').ToList();

                if (_attFFiles != null)
                {
                    foreach (var item in _attFFiles)
                    {
                        try
                        {
                            var physicalPath = Path.Combine(Env.WebRootPath, item.TrimStart('/', '\\').Replace('/', '\\'));

                            if (File.Exists(physicalPath))
                                File.Delete(physicalPath);
                        }
                        catch { /* ignore file delete errors */ }
                    }
                }

