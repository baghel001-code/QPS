    private async Task GetSavedValues()
    {
        try
        {
            // ✅ Guard: PO null check
            if (PO == null)
            {
                await ShowErrorDialog("Warning", "PO data is missing.");
                return;
            }

            if (string.IsNullOrEmpty(PO.PoNumber))
            {
                await ShowErrorDialog("Warning", "PO Number is missing.");
                return;
            }

            if (PO.InspId <= 0)
            {
                // New inspection — nothing to fetch
                DisplayAQL();
                ReOrderDefects();
                return;
            }

            var selectRequest = new SelectListReq
            {
                Id = PO.InspId,
                Cmd = CmdNames.Get_Inspect_Data,
                StrField = string.Empty
            };

            IsLoading = true; StateHasChanged();
            var existingInspection = await ApiMasterService.CallingAPI<InspectResponse, SelectListReq>(AllApiNames.GET_INSPECT_DATA!, selectRequest);
            IsLoading = false; StateHasChanged();

            // ✅ Guard: Null API response
            if (existingInspection == null)
            {
                Snackbar.Add("No response from server. Please try again.", Severity.Error);
                return;
            }

            if (existingInspection.responseCode == 0 && existingInspection.responseMessage?.ToUpper() == "SUCCESS")
            {
                // ✅ Guard: InspectDetails null check
                if (existingInspection.InspectDetails != null && existingInspection.InspectDetails.INSPECT_ID > 0)
                {
                    _model = mapper.Map<InspectionModel>(existingInspection.InspectDetails);
                    _model.Defects.Clear();

                    // ✅ Guard: Defects null check
                    if (existingInspection.Defects != null)
                    {
                        foreach (var detail in existingInspection.Defects)
                        {
                            _model.Defects.Add(mapper.Map<InspectionDefectDto>(detail));
                        }
                    }

                    isShow = _model.IsComplete;
                }

                // ✅ Guard: AQL list null check
                _model.AqlData = existingInspection.AQLList?.Any() == true ? existingInspection.AQLList : new List<AQLDataResponse>();

                _model.POOfferQuantity = PO.OfferedQty.ToString("0");
                _model.POTotalQuantity = PO.POTotalQty.ToString("0");
            }

            DisplayAQL();
            ReOrderDefects();
        }
        catch (Exception ex)
        {
            IsLoading = false;
            Snackbar.Add($"Error loading inspection data: {ex.Message}", Severity.Error);
        }
    }
