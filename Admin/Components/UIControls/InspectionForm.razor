    public class InMemoryBrowserFile : IBrowserFile
    {
        private readonly byte[] _fileBytes;

        public InMemoryBrowserFile(byte[] fileBytes, string name, string contentType)
        {
            try
            {
                if (fileBytes == null || fileBytes.Length == 0)
                    throw new ArgumentException("File content cannot be null or empty.", nameof(fileBytes));

                if (string.IsNullOrWhiteSpace(name))
                    throw new ArgumentException("File name cannot be null or empty.", nameof(name));

                if (string.IsNullOrWhiteSpace(contentType))
                    throw new ArgumentException("Content type cannot be null or empty.", nameof(contentType));

                _fileBytes = fileBytes;
                Name = name;
                Size = fileBytes.LongLength;
                LastModified = DateTimeOffset.Now;
                ContentType = contentType;
            }
            catch (Exception ex)
            {
                throw new InvalidOperationException(
                    $"Failed to initialize InMemoryBrowserFile. Error: {ex.Message}", ex);
            }
        }

        public DateTimeOffset LastModified { get; }

        public string Name { get; }

        public long Size { get; }

        public string ContentType { get; }

        public Stream OpenReadStream(long maxAllowedSize = 512000, CancellationToken cancellationToken = default)
        {
            try
            {
                cancellationToken.ThrowIfCancellationRequested();

                if (_fileBytes == null || _fileBytes.Length == 0)
                    throw new InvalidOperationException("File data is unavailable.");

                if (_fileBytes.LongLength > maxAllowedSize)
                {
                    throw new IOException(
                        $"File size exceeds the allowed limit of {maxAllowedSize} bytes.");
                }

                return new MemoryStream(_fileBytes, writable: false);
            }
            catch (OperationCanceledException)
            {
                throw;
            }
            catch (Exception ex)
            {
                throw new IOException(
                    $"Error while opening file stream for '{Name}'. Error: {ex.Message}", ex);
            }
        }
    }
    private async Task UploadFiles(IReadOnlyList<IBrowserFile> selectedFiles)
    {
        try
        {
            const int maxFileCount = 20;
            const long maxFileSize = 10 * 1024 * 1024; // 10 MB

            if (selectedFiles == null || !selectedFiles.Any())
            {
                Snackbar.Add("No files selected.", Severity.Warning);
                return;
            }

            if (selectedFiles.Count > maxFileCount)
            {
                Snackbar.Add($"You can upload a maximum of {maxFileCount} files at a time.", Severity.Warning);
                return;
            }

            // Ensure collections are initialized
            files ??= new List<IBrowserFile>();
            largSizeFiles ??= new List<string>();

            // Ensure upload directory exists
            var uploadsFolder = Path.Combine(Env.WebRootPath, "uploads");

            if (!Directory.Exists(uploadsFolder))
            {
                Directory.CreateDirectory(uploadsFolder);
            }



            foreach (var file in selectedFiles)
            {
                try
                {
                    if (file == null)
                        continue;

                    var ext = Path.GetExtension(file.Name)?.ToLowerInvariant();

                    if (string.IsNullOrWhiteSpace(ext))
                    {
                        largSizeFiles.Add(file.Name);
                        continue;
                    }

                    var uniqueFileName = $"{Guid.NewGuid()}{ext}";
                    var filePath = Path.Combine(uploadsFolder, uniqueFileName);

                    // Image Files
                    if (ext == ".jpg" || ext == ".jpeg" || ext == ".png")
                    {

                        await using var stream = file.OpenReadStream(maxFileSize);

                        using var image = await Image.LoadAsync(stream);

                        // Resize image if width exceeds 1024px
                        if (image.Width > 1024)
                        {
                            double scale = 1024.0 / image.Width;
                            int newHeight = (int)(image.Height * scale);

                            image.Mutate(x => x.Resize(1024, newHeight));
                        }

                        await using var outputStream = new MemoryStream();

                        IImageEncoder encoder = ext switch
                        {
                            ".jpg" or ".jpeg" => new JpegEncoder
                            {
                                Quality = 80
                            },

                            ".png" => new PngEncoder
                            {
                                CompressionLevel = PngCompressionLevel.Level6
                            },

                            _ => new JpegEncoder
                            {
                                Quality = 80
                            }
                        };

                        await image.SaveAsync(outputStream, encoder);

                        long compressedSize = outputStream.Length;

                        if (compressedSize > maxFileSize)
                        {
                            largSizeFiles.Add(file.Name);
                            continue;
                        }

                        // Reset stream position
                        outputStream.Position = 0;

                        IBrowserFile compressedFile = new InMemoryBrowserFile(outputStream.ToArray(), file.Name, file.ContentType);

                        files.Add(compressedFile);

                    }
                    else
                    {

                        // Non-image files
                        if (file.Size > maxFileSize)
                        {
                            largSizeFiles.Add(file.Name);
                            continue;
                        }

                        files.Add(file);
                    }
                }
                catch (IOException ioEx)
                {
                    Snackbar.Add($"File error for '{file?.Name}': {ioEx.Message}", Severity.Error);
                }
                catch (UnknownImageFormatException)
                {
                    Snackbar.Add($"Unsupported image format: {file?.Name}", Severity.Warning);
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Error processing file '{file?.Name}': {ex.Message}", Severity.Error);
                }
            }

            // Large file warning
            if (largSizeFiles.Any())
            {
                Snackbar.Add($"Some files exceeded the 10 MB limit: {string.Join(", ", largSizeFiles)}", Severity.Warning,
                    config =>
                    {
                        config.VisibleStateDuration = 2000;
                    });
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error during file upload: {ex.Message}", Severity.Error);
        }
    }
