    private async Task OpenFile(IBrowserFile file)
    {
        try
        {
            if (file == null)
            {
                Snackbar.Add("No file selected.", Severity.Warning);
                return;
            }

            const long maxFileSize = 10 * 1024 * 1024; // 10 MB

            if (file.Size > maxFileSize)
            {
                Snackbar.Add($"File size exceeds the maximum allowed limit of {maxFileSize / (1024 * 1024)} MB.", Severity.Warning);
                return;
            }

            await using var stream = file.OpenReadStream(maxFileSize);
            await using var ms = new MemoryStream();

            await stream.CopyToAsync(ms);

            var bytes = ms.ToArray();

            if (bytes == null || bytes.Length == 0)
            {
                Snackbar.Add("File content is empty.", Severity.Warning);
                return;
            }

            await JS.InvokeVoidAsync("openFileInNewTab", bytes, file.ContentType);
        }
        catch (IOException ioEx)
        {
            Snackbar.Add($"File read error: {ioEx.Message}", Severity.Error);
        }
        catch (JSException jsEx)
        {
            Snackbar.Add($"JavaScript error while opening file: {jsEx.Message}", Severity.Error);
        }
        catch (OperationCanceledException)
        {
            Snackbar.Add("File operation was cancelled.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error while opening file: {ex.Message}", Severity.Error);
        }
    }
