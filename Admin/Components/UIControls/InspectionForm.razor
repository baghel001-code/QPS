    protected override async Task OnInitializedAsync()
    {

        try
        {
            // ✅ Guard : PO parameter null check
            if (PO == null)
            {
                Snackbar.Add("Inspection data is missing.", Severity.Error);
                PO = new();
                isFatched = false;
            }
            else
            {
                var fabricBeforeSync = PO.Fabric;
                bool isClosedRequest = PO.Is_Inspection_Complete || PO.Status_Code is 7 or 9 or 10;

                // Open requests only: silent auto-sync, no confirmation popup (E11, N13, N14)
                if (!isClosedRequest)
                    await SyncPOdetails(askConfirmation: false);

                isFatched = IsEditMode;
                await GetSavedValues();

                // Keep the saved fiber content. Replace it only when it is empty, or when it was simply
                // the old PO fabric on an open request (E10, E11)
                if (string.IsNullOrWhiteSpace(_model.FiberContentOnPo) ||
                    (!isClosedRequest && _model.FiberContentOnPo == fabricBeforeSync))
                {
                    _model.FiberContentOnPo = PO.Fabric;
                }


                // // Sync the PO from SAP
                // await SyncPOdetails();
                // isFatched = IsEditMode;
                // await GetSavedValues();
                // _model.FiberContentOnPo = PO.Fabric;


                // Roles are mutually exclusive by construction — QA/QAM-as-self vs QAM-on-sub/QAAdmin

                isSelfInspector = !_CurrentUser.IsQAAdmin && PO.InspectorId.ToString() == _CurrentUser.UserCode;                 // QA, or QAM acting as their own inspector
                isAdminOrSubEdit = _CurrentUser.IsQAAdmin || (_CurrentUser.IsQAM && PO.InspectorId.ToString() != _CurrentUser.UserCode);        // QAAdmin, or QAM editing a sub-QA's report


                // ✅ FIX: Replace .First() with .FirstOrDefault() — THIS IS THE LINE 1352/1363
                if (PO.InspectionTypeList != null && PO.InspectionTypeList.Any())
                {
                    var inspType = PO.InspectionTypeList.FirstOrDefault(a => a.Master_ID == PO.InspectionTypeId);

                    inspecitonType = inspType?.Master_Name ?? "Unknown";

                    if (inspType == null)
                    {
                        // Log warning but don't crash
                        Snackbar.Add(
                            $"Inspection type ID {PO.InspectionTypeId} not found in list.",
                            Severity.Warning
                        );
                    }
                }
                else
                {
                    inspecitonType = "Unknown";
                    Snackbar.Add("Inspection type list is empty.", Severity.Warning);
                }
            }

            // ✅ Guard 3: Load masters safely
            await GetAllMasters();
            SetAll();

            // ✅ Guard 4: Only start autosave if model is not complete
            if (!_model.IsComplete)
            {
                _cts = new CancellationTokenSource();
                _timer = new PeriodicTimer(TimeSpan.FromSeconds(20));
                _backgroundTask = RunAutoSaveAsync(_cts.Token);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading inspection form: {ex.Message}", Severity.Error);
            // Don't crash the circuit — close dialog gracefully
            MudDialog?.Close();
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task Submit()
    {
        if (isSubmitting) return;
        isSubmitting = true;

        try
        {
            bool? dres = await DialogService.ShowMessageBox("Confirmation", "Do you want to submit Inspection details?", yesText: "  Yes!  ", cancelText: "   No   ");
            if (dres == null)
            {
                return;
            }
            else
            {
                if (isSelfInspector && _model.IsComplete)
                {
                    await ShowErrorDialog("Validation", "This report is already completed and cannot be modified.");
                    return;
                }
                IsCompleteInSubmit = true;
                _model.IsComplete = true;
                await Save();
            }
        }
        finally
        {
            isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<string> ProcessFileUploadsAsync(string? existingAttachmentValue)
    {
        if (files.Count == 0) return string.IsNullOrEmpty(existingAttachmentValue) ? string.Empty : existingAttachmentValue;


        var folderPath = Path.Combine(Directory.GetCurrentDirectory(), UploadFolder);
        if (!Directory.Exists(folderPath))
            Directory.CreateDirectory(folderPath);

        fileNames = new List<string>();
        foreach (var file in files)
        {
            var fileName = Guid.NewGuid() + Path.GetExtension(file.Name);
            var filePath = Path.Combine(folderPath, fileName);

            await using var inputStream = file.OpenReadStream(MaxFileSize);
            await using var fileStream = new FileStream(filePath, FileMode.Create);
            await inputStream.CopyToAsync(fileStream);

            fileNames.Add(Path.Combine(relPath, fileName).Replace("\\", "/"));
        }

        ClearAsync();

        // Append, don't overwrite — same fix already applied to GenAttachmentFirst
        return string.IsNullOrEmpty(existingAttachmentValue)
            ? string.Join(",", fileNames)
            : existingAttachmentValue + "," + string.Join(",", fileNames);
    }
    private async Task Save()
    {
        fileNames = new List<string>(); // reset defensively at top, avoids null-ref on failure cleanup

        // ─── File upload — routed by role, BEFORE validation so checks below see current values ───
        if (isSelfInspector)
        {
            _model.TestReportAttachment = await ProcessFileUploadsAsync(_model.TestReportAttachment);
        }
        else if (isAdminOrSubEdit)
        {
            _model.GenAttachmentFirst = await ProcessFileUploadsAsync(_model.GenAttachmentFirst);
        }
        // ─── Validations ─────────────────────────────────────────────
        if (isSelfInspector && _model.IsComplete && !IsCompleteInSubmit)
        {
            await ShowErrorDialog("Validation", "This report is already completed and cannot be modified.");
            return;
        }
        if (PO.InspId <= 0)
        {
            await ShowErrorDialog("Validation", "PO and Inpection Data is missing.");
            return;
        }
        if (_model.InspectionResult == 2 && _model.Reason_for_fail == 0)
        {
            await ShowErrorDialog("Validation", "Fail Reason is required.");
            return;
        }
        if (_model.GptStatus == 2 && string.IsNullOrEmpty(_model.GptApprovedBy))
        {
            await ShowErrorDialog("Validation", "GPT Approved By field is required.");
            return;
        }
        if (_model.GptStatus == 2 && string.IsNullOrEmpty(_model.GptApprovedDate?.ToString()))
        {
            await ShowErrorDialog("Validation", "GPT Approved Date field is required.");
            return;
        }
        if (_model.gptElasticStatus == 2 && string.IsNullOrEmpty(_model.gptElasticApprovedBy))
        {
            await ShowErrorDialog("Validation", "Elastic approved by is required.");
            return;
        }
        if (_model.gptElasticStatus == 2 && string.IsNullOrEmpty(_model.gptElasticApprovedDate?.ToString()))
        {
            await ShowErrorDialog("Validation", "Elastic approved date is required.");
            return;
        }
        if (_model.ZipperStatus == 2 && string.IsNullOrEmpty(_model.ZipperApprovedBy))
        {
            await ShowErrorDialog("Validation", "Zipper Approved By field is required.");
            return;
        }
        if (_model.ZipperStatus == 2 && string.IsNullOrEmpty(_model.ZipperApprovedDate?.ToString()))
        {
            await ShowErrorDialog("Validation", "Zipper Approval Date field is required.");
            return;
        }

        // ─── Attachment-required-on-complete, checked against the CORRECT field per role ───
        if (_model.IsComplete)
        {
            if (isSelfInspector && string.IsNullOrEmpty(_model.TestReportAttachment))
            {
                await ShowErrorDialog("Validation!", " QA Attachment is required.");
                _model.IsComplete = false;
                return;
            }
            // if (isAdminOrSubEdit && string.IsNullOrEmpty(_model.GenAttachmentFirst))
            // {
            //     await ShowErrorDialog("Validation!", "Admin/QAM attachment is required.");
            //     return;
            // }
        }

        await form.Validate();
        if (form.IsValid)
        {
            // ─── Set required fields ──────────────────────────────────────
            _model.UserId = _CurrentUser.UserId;
            _model.InspectionId = PO.InspId;
            _model.InspectorCode = _CurrentUser.UserCode;

            if (isAdminOrSubEdit)
                _model.Is_Edit_By_Admin = true;

            // ─── Remove protected defect rows before saving ───────────────
            _model.Defects.RemoveAll(a => protectedIds.Contains(a.Defects_Id));

            // ─── Handle Abortive (InspectionResult == 4) ─────────────────
            if (_model.InspectionResult == 4)
            {
                _model.AbortiveReasonIds = SelectedRgn;
                // GPT fields
                _model.GptNo = string.Empty;
                _model.GptStatus = 0;
                _model.GptApprovedBy = string.Empty;
                _model.GptApprovedDate = null;
                _model.Area_Of_Fail_GPTR = string.Empty;

                // Elastic fields
