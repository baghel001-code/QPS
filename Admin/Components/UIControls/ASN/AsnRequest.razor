@using Admin.Components.Shared
@using Application.DTOs.Asn
@using System.Security.Claims
@using Application.Interfaces.V1.User
<MudDialog>
    <DialogContent>
        <MudPaper Elevation="0" Class="pa-0">
            <MudPaper Class="pa-4 mb-6 d-flex align-center" Style="background-color:darkblue; color:white; border-radius:8px 8px 0 0;" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Color="Color.Surface" Class="mr-2" Size="Size.Small" />
                <MudText Color="Color.Surface" Typo="Typo.subtitle2">
                    QPS Portal
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="mx-1 mb-1" />
                    ASN Request
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="mx-1 mb-1" />
                    <b>Create New Request</b>
                </MudText>
            </MudPaper>
            <MudForm @ref="_form" Model="_model" Class="px-4 pb-4">
                <MudPaper Outlined="true" Class="pa-4 mb-6" Style="background-color:#f7f8fa; border-radius:8px;">
                    <MudText Typo="Typo.overline" Class="mb-2" Style="color:#6b7280; letter-spacing:0.5px;">
                        Purchase Order Details
                    </MudText>

                    <MudGrid>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.caption" Style="color:#6b7280;">PO Number</MudText>
                            <MudText Typo="Typo.subtitle1" Style="font-weight:600;">@_model.PoNumber</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="2">
                            <MudText Typo="Typo.caption" Style="color:#6b7280;">PO Qty</MudText>
                            <MudText Typo="Typo.subtitle1" Style="font-weight:600;">@_model.TotalOrderQty.ToString("N0")</MudText>
                        </MudItem>

                        <MudItem xs="6" sm="2">
                            <MudText Typo="Typo.caption" Style="color:#6b7280;">Total ASN</MudText>
                            <MudButton OnClick="OpenAsnDetails" Color="Color.Primary" Variant="Variant.Outlined">
                                @Summary.TotalAsnInCurrentPo
                            </MudButton>
                        </MudItem>
                        <MudItem xs="6" sm="2">
                            <MudText Typo="Typo.caption" Style="color:#6b7280;">Completed ASN</MudText>
                            <MudButton Color="Color.Success" Variant="Variant.Outlined">
                                @Summary.CompleteAsnInCurrentPo
                            </MudButton>
                        </MudItem>
                        <MudItem xs="6" sm="2">
                            <MudText Typo="Typo.caption" Style="color:#6b7280;">Pending ASN</MudText>
                            <MudButton Color="Color.Secondary" Variant="Variant.Outlined">
                                @Summary.PendingAsnInCurrentPo
                            </MudButton>
                        </MudItem>
                    </MudGrid>

                    <MudProgressLinear Color="Color.Primary" Value="@BalancePercent" Class="mt-3" Rounded="true" Size="Size.Small" />
                    <MudText Typo="Typo.caption" Class="mt-1" Style="color:#6b7280;">
                        @_model.ReminingQty.ToString("N0") of @_model.TotalOrderQty.ToString("N0") remaining to ASN.
                    </MudText>

                    <MudTable Items="@_pendingRows" Dense="true" FixedHeader="true" Height="80px" Hover="true" Elevation="0" Class="mt-2">
                        <HeaderContent>
                            <MudTh>S.No.</MudTh>
                            <MudTh>Insp.#</MudTh>
                            <MudTh>Ship Qty</MudTh>
                            <MudTh>ASN Qty</MudTh>
                            <MudTh>Balance Qty</MudTh>
                            <MudTh>Req.Date</MudTh>
                            <MudTh>Status</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="row">
                            <MudTd DataLabel="S.No.">@row.SNo</MudTd>
                            <MudTd DataLabel="Inspection#">@row.Group.InspectionNumber</MudTd>
                            <MudTd DataLabel="Ship Qty">@row.Group.ShipQty.ToString("N0")</MudTd>
                            <MudTd DataLabel="ASN Qty">@row.Row.RequestedQty.ToString("N0")</MudTd>
                            <MudTd DataLabel="Balance Qty">@row.Row.BalanceQty.ToString("N0")</MudTd>
                            <MudTd DataLabel="Date">@row.Row.DateOfCreation.ToString("dd-MMM-yyyy")</MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                                    @row.Row.Status
                                </MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>

                <MudGrid>
                    <MudItem xs="12" sm="3">
                        <MudText Typo="Typo.caption" Style="color:#6b7280;">Inspection Number</MudText>
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">@_model.InspectionNo</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudText Typo="Typo.caption" Style="color:#6b7280;">Ship Qty</MudText>
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600; color:#1b3a6b;">@_model.ShipQty.ToString("N0")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudText Typo="Typo.caption" Style="color:#6b7280;">Total ASN Qty</MudText>
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600; color:#1b3a6b;">@_model.TotalInspAsnQty.ToString("N0")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudText Typo="Typo.caption" Style="color:#6b7280;">Balance Qty</MudText>
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600; color:#1b3a6b;">@_model.TotalBalanceQty.ToString("N0")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="3">

                        <MudNumericField T="decimal?"
                                         Label="ASN Quantity"
                                         @bind-Value="_model.AsnQuantity"
                                         Variant="Variant.Outlined"
                                         Required="true"
                                         RequiredError="ASN Quantity is required"
                                         Adornment="Adornment.End"
                                         AdornmentText="pcs"
                                         HelperText="@($"Cannot exceed {_model.TotalBalanceQty:N0} pcs")"
                                         Validation="@(new Func<decimal?, string>(ValidateAsnQuantity))"
                                         Immediate="true" />


                    </MudItem>
                    <MudItem xs="12" sm="12">
                        <MudTextField T="string"
                                      Label="Remarks"
                                      @bind-Value="_model.Remarks"
                                      Variant="Variant.Outlined"
                                      Placeholder="Optional notes about this shipment..." />
                    </MudItem>
                </MudGrid>


                <MudDivider Class="my-4" />


            </MudForm>
        </MudPaper>
    </DialogContent>

    <DialogActions>
        <div class="d-flex justify-end gap-3">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       OnClick="Cancel"
                       Disabled="_isSubmitting">
                Cancel
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="SubmitRequest"
                       Disabled="_isSubmitting"
                       StartIcon="@(_isSubmitting ? null : Icons.Material.Filled.Send)">
                @if (_isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Submitting...</span>
                }
                else
                {
                    <span>Submit Request</span>
                }
            </MudButton>


        </div>
    </DialogActions>
</MudDialog>
<Loader IsVisible="@IsLoading" />
@code {
    @inject IDialogService DialogService
    [Inject] protected ICurrentUserService CurrentUser { get; set; } = default!;
    private MudForm _form = default!;

    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public AsnRequestModel _model { get; set; } = new();
  
    public AsnDetailsSummary Summary { get; set; } = new();

    private bool _isSubmitting;
    bool IsLoading = false;
  

    private double BalancePercent => _model.TotalOrderQty > 0 ? (double)(Summary.TotalRequestedQty / _model.TotalOrderQty * 100) : 0;

    private string? ValidateAsnQuantity(decimal? value)
    {
        if (value is null)
            return "ASN Quantity is required";

        if (value <= 0)
            return "ASN Quantity must be greater than zero";

        if (value > _model.TotalBalanceQty)
            return $"Cannot exceed balance Qty ({_model.TotalBalanceQty:N0})";

        return null;
    }

    protected override async Task OnInitializedAsync()
    {
        await GetASNSummary();
    }
   
    private async Task GetASNSummary()
    {
        SummaryRequest summaryRequest = new SummaryRequest { PO_NUMBER = _model.PoNumber };
        Summary = await ApiMasterService.CallingAPI<AsnDetailsSummary, SummaryRequest>(AllApiNames.GET_ASN_SUMMARY!, summaryRequest);
       
        _model.TotalPOASNQty = Summary.TotalRequestedQty;
        _model.TotalInspAsnQty = Summary.InspWiseTotalRequestedQty(_model.InspectionNo);
    }
    // Replace the previous Dapper-direct call with an HTTP call to QPSAPI
    private async Task SubmitRequest()
    {
        bool? dres = await DialogService.ShowMessageBox("Confirmation", $"Do you want to create ASN request for {_model.AsnQuantity} pcs?", yesText: "  Yes!  ", cancelText: "   No   ");
        if (dres == null)
        {
            return;
        }
        else
        {
            await _form.Validate();
            if (!_form.IsValid) return;

            _isSubmitting = true;
            try
            {
                var dto = new CreateAsnRequestDto
                {
                    InspId = _model.InspId,              // needs to exist on POHeader / be passed into the dialog
                    InspectId=_model.InspectId,
                    ShipQty = (int)_model.ShipQty,
                    RequestedQty = (int)_model.AsnQuantity!.Value,
                    Remarks = _model.Remarks,
                    CreatedBy = CurrentUser.UserId
                };
                var res = await ApiMasterService.CallingAPI<GenRes, CreateAsnRequestDto>(AllApiNames.ASN_REQUEST_CREATE!, dto);
                if (res.responseCode.Equals(0) && res.responseMessage!.ToUpper() == "SUCCESS")
                {
                    Snackbar.Add("ASN request submitted", Severity.Success);
                    MudDialog?.Close(DialogResult.Ok(true));
                }
                else
                {
                    Snackbar.Add($"Failed to submit: {res.responseMessage}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to submit: {ex.Message}", Severity.Error);
            }
            finally
            {
                _isSubmitting = false;
            }
        }
    }



    private void Cancel() => MudDialog?.Cancel();



    private async Task OpenAsnDetails()
    {
        var parameters = new DialogParameters<AsnDetailsDialog> { { x => x.Summary, Summary } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraLarge, FullWidth = true };
        await DialogService.ShowAsync<AsnDetailsDialog>("ASN Details", parameters, options);
    }
   
    private List<PendingAsnRowVm> _pendingRows = new();

    protected override void OnParametersSet()
    {
        int sno = 1;
        _pendingRows = Summary.Inspections
            .SelectMany(group => group.Rows
                .Where(r => r.Status == "Pending")
                .Select(r => new PendingAsnRowVm { SNo = sno++, Group = group, Row = r }))
            .ToList();
    }
}

