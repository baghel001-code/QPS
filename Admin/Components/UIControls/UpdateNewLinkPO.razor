@using Admin.Components.Pages.UserMaster
@using Admin.Components.Shared
@using Application.Interfaces.V1.User
@using EmailService.Models
@using MudExtensions
@using System.Text.RegularExpressions
@using System.Security.Claims

@inject IPoSyncService _poSyncService

<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudGrid>
                <MudItem xs="12" md="12">
                    <MudGrid>
                        <MudItem xs="12" md="12">
                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary">PO Details </MudChip>
                            <MudChip T="string" OnClick="async () => await SyncPOdetails()" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Sync" Color="MudBlazor.Color.Success">Sync PO Details</MudChip>
                        </MudItem>
                        <!-- Vendor Code -->
                        <MudItem xs="12" md="2">
                            <MudTextField T="string" Label="PO Number" ReadOnly="true" Value="PO.PO_NUMBER" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudTextField T="string" Label="Link PO Number" @bind-Value="LinkPONumber" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudTextField Label="Total Qty." Value="PO.PO_QTY" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Vendor Name" ReadOnly="true" Value="PO.VENDOR" Required="true" />
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Fabric" ReadOnly="true" Value="PO.FABRIC" />
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudTextField T="string" Label="Color" ReadOnly="true" Value="PO.COLOR" />
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudTextField Label="Offered Qty." Value="PO.OFFERED_QTY" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudTextField Label="Date of Inspection" Value="@(PO.DATE_OF_INSPECTION)" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudTextField T="string" Label="DoI Assigned by QA" Value="@(PO.QA_ASSIGNED_DOI)" ReadOnly="true" />
                        </MudItem>

                    </MudGrid>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Save" Color="Color.Success" Variant="Variant.Outlined">Link PO Number</MudButton>
    </DialogActions>
</MudDialog>
<Loader IsVisible="@IsLoading" />
@if (isRunning)
{
    <div class="overlay">
        <div class="progress-container">
            <div class="progress-bar" style="width:@progress%"></div>
            <span class="progress-text">@progress %</span>
        </div>
    </div>


}
@code {
    [Inject] protected ICurrentUserService _CurrentUser { get; set; } = default!;
    private int progress = 0;
    bool isRunning = false;
    bool isShow;
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }
    [Parameter]
    public INSPECTION_REQUEST_LIST_MODEL PO { get; set; } = new();

    private MudForm form;

    bool IsLoading = false;
    private string LinkPONumber = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (PO == null)
        {
            PO = new();
        }
        else
        {
            LinkPONumber = PO.LINK_PO_NUMBER;
        }
    }


    //Get_Roles_List
    private async void Save()
    {

        if (string.IsNullOrEmpty(LinkPONumber))
        {
            await ShowErrorDialog("Validation", "New PO number is required.");
            return;
        }

        bool? dres = await DialogService.ShowMessageBox("Confirmation", "Do you want to proceed with updating the linked Purchase Order number?", yesText: "  Yes!  ", cancelText: "   No   ");
        if (dres == null)
        {
            return;
        }
        else
        {
            await form.Validate();

            if (form.IsValid)
            {
                UpdateLinkPO_Details reqObj = new UpdateLinkPO_Details()
                {
                    INSP_ID = PO.INSP_ID,
                    USER_ID = _CurrentUser.UserId,
                    LinkPoNumber = LinkPONumber

                };

                var res1 = await ApiMasterService.CallingAPI<GenRes, UpdateLinkPO_Details>(AllApiNames.UPDATE_LINK_PO!, reqObj);
                if (res1.responseCode.Equals(0))
                {
                    Snackbar.Add("New PO linked successfully.", Severity.Success);
                    MudDialog?.Close();
                }
                else
                {
                    await ShowErrorDialog("Error!", res1.responseMessage!);
                }
            }
        }

    }

    private void CloseDialog()
    {
        MudDialog?.Close();
    }
    private async Task ShowErrorDialog(string Tital, string message)
    {
        await DialogService.ShowMessageBox(Tital, message);
    }

    private async Task SyncPOdetails()
    {
        bool? dres = await DialogService.ShowMessageBox("Confirmation", "Do you want to synchronize PO details?", yesText: "  Yes  ", cancelText: "   No  ");
        if (dres == null) return;

        try
        {
            isRunning = true;
            progress = 0;

            var currentAsHeader = new POHeader { PoNumber = PO.PO_NUMBER, Id = PO.POID };
            var progressReporter = new Progress<int>(p => { progress = p; InvokeAsync(StateHasChanged); });
            var result = await _poSyncService.SyncAsync(currentAsHeader, _CurrentUser.UserId, progressReporter, forceSync: true);

            await ShowErrorDialog("Info", result.Message);
        }
        catch (Exception ex)
        {
            await ShowErrorDialog("Error!", ex.Message!);
        }
        finally
        {
            progress = 0;
            isRunning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SyncPOdetailsOld()
    {
        bool? dres = await DialogService.ShowMessageBox("Confirmation", "Do you want to synchronize PO details?", yesText: "  Yes  ", cancelText: "   No  ");
        if (dres == null)
        {
            return;
        }
        try
        {

            isRunning = true;
            POHeader fetchedPO = new();
            fetchedPO.PoNumber = PO.PO_NUMBER;

            progress = 0;
            if (!string.IsNullOrEmpty(fetchedPO.PoNumber))
            {
                //------------------------------
                string pno = fetchedPO.PoNumber;
                var req = new SAP_API_DATA_Req
                {
                    Param = fetchedPO.PoNumber,  // Ensure no null
                    TaskName = "SAP_PO_DETAILS"
                };
                progress = 10;
                await InvokeAsync(StateHasChanged);
                // IsLoading = true;
                var sapApiData = await ApiMasterService
                    .CallingAPI<ApiData, SAP_API_DATA_Req>(AllApiNames.GET_SAP_API!, req)
                    .ConfigureAwait(false);
                // IsLoading = false;
                progress = 30;
                await InvokeAsync(StateHasChanged);

                if (sapApiData is not null)
                {
                    // IsLoading = true;
                    var poDetails = await ApiMasterService
                        .CallingSAPAPI<POSAPResponse, string>(string.Empty, sapApiData)
                        .ConfigureAwait(false);
                    // IsLoading = false;
                    progress = 60;
                    await InvokeAsync(StateHasChanged);

                    if (poDetails.APPS_FOOTWEAR_DETAILS != null)
                    {
                        if (poDetails.APPS_FOOTWEAR_DETAILS.Any() == true)  // Safe and concise
                        {
                            var Podtl = poDetails.APPS_FOOTWEAR_DETAILS.First();

                            if (Podtl is not null)  // extra guard
                            {
                                fetchedPO = fetchedPO.MapToHeader(poDetails);
                                fetchedPO.Insp_Req_Status = "Update";
                                fetchedPO.CreatedBy = _CurrentUser.UserId;
                                fetchedPO.Id = PO.POID;

                                var res1 = await ApiMasterService.CallingAPI<GenRes, POHeader>(AllApiNames.SYNC_PO_DETAILS!, fetchedPO);
                                progress = 90;
                                await InvokeAsync(StateHasChanged);
                                if (!res1.responseCode.Equals(0))
                                {
                                    await ShowErrorDialog("Info", "PO has not been synced.");
                                }
                                else
                                {
                                    for (int i = 90; i <= 100; i++)
                                    {
                                        await Task.Delay(100);
                                        progress = i;
                                        await InvokeAsync(StateHasChanged);
                                    }
                                    await ShowErrorDialog("Info", "PO details synchronized successfully.");
                                }


                            }
                        }
                        else
                        {
                            await ShowErrorDialog("Info", "PO not found.");
                        }
                    }
                    else
                    {
                        await ShowErrorDialog("Info", "Requesting server is not responding.");
                    }
                }
                else
                {
                    await ShowErrorDialog("Error", "SAP_PO_DETAILS Api not found.");
                }

            }


        }
        catch (Exception ex)
        {
            await ShowErrorDialog("Error!", ex.Message!);
        }
        finally
        {
            progress = 0; // ← reset progress
            isRunning = false; // ← add this
            await InvokeAsync(StateHasChanged);
        }
    }


}
