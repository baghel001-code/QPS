<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudGrid>
                <MudItem xs="12" md="12">
                    <MudGrid>
                        <MudItem xs="12" md="12">
                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary">PO Details </MudChip>
                        </MudItem>
                        <!-- First Row  -->
                        <MudItem xs="12" md="2">
                            @if (IsEditMode)
                            {
                                <MudTextField T="string" Label="PO Number" ReadOnly="isFatched" @bind-Value="PO.PoNumber" Required="true" />
                            }
                            else
                            {
                                if (isFatched)
                                {
                                    <MudTextField T="string" Label="PO Number" ReadOnly="isFatched" @bind-Value="PO.PoNumber" Required="true" />
                                }
                                else
                                {
                                    <MudTextField T="string" Label="PO Number" ReadOnly="isFatched" @bind-Value="PO.PoNumber" Required="true" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FindInPage" AdornmentColor="Color.Secondary" OnAdornmentClick="@(() => OnFindClick())" />
                                }
                            }
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudTextField Label="Total Qty." @bind-Value="PO.POTotalQty" ReadOnly="true" />
                        </MudItem>

                        <MudItem xs="12" md="2">
                            <MudTextField T="string" Label="Vendor Code" ReadOnly="true" @bind-Value="PO.VendorCode" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Vendor Name" ReadOnly="true" @bind-Value="PO.VendorName" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudTextField T="string" Label="Apparels" ReadOnly="true" @bind-Value="PO.Apparels" />
                        </MudItem>
                        <!-- Second Row  -->

                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Fabric" ReadOnly="true" @bind-Value="PO.Fabric" />
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudTextField T="string" Label="Color" ReadOnly="true" @bind-Value="PO.Color" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Buyer" ReadOnly="true" @bind-Value="PO.BuyerName" />
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudTextField T="string" Label="Category" ReadOnly="true" @bind-Value="PO.Category" />
                        </MudItem>
                        <!-- Third Row  -->

                        <MudItem xs="12" md="2">
                            <MudTextField Label="Offered Qty." @bind-Value="PO.OfferedQty" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudDatePicker @bind-Date="PO.SelectedDateDOI"
                                           Label="Allocate Date"
                                           Required="true" />
                        </MudItem>
                        @*  <MudItem xs="12" md="3">
                            <MudTimePicker @bind-Time="PO.SelectedTimeDOI"
                                           Label="Allocate Time"
                                           Required="true"
                                           TimeFormat="hh:mm tt" AmPm="true" />
                        </MudItem> *@
                        <MudItem xs="12" md="2">
                            <MudSelect T="int" Label="Select QAM" @bind-Value="PO.RegionId" Required="true">
                                <MudSelectItem Value="0">--Select--</MudSelectItem>
                                @foreach (var item in PO.RegionList)
                                {
                                    <MudSelectItem Value="@item.Master_ID">
                                        @( $"{item.Master_Name}")
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudSelect T="int" Label="Select Inspection Type" @bind-Value="PO.InspectionTypeId" Required="true">
                                <MudSelectItem Value="0">--Select--</MudSelectItem>
                                @foreach (var item in PO.InspectionTypeList)
                                {
                                    <MudSelectItem Value="@item.Master_ID">
                                        @( $"{item.Master_Name}")
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudCheckBox T="bool" Value="tempQcAtDcValue" Label="QC at DC" Color="Color.Primary" ValueChanged="OnQcAtDcChanged" />
                        </MudItem>
                        <!-- Forth Row  -->

                        <MudItem xs="12" md="12">
                            <MudSelect T="int"
                                       Label="Select Inspection Location"
                                       Value="@PO.AddressId"
                                       ValueChanged="OnLocationChanged"
                                       Required="true">
                                <MudSelectItem Value="0">--Select--</MudSelectItem>
                                @foreach (var item in PO.AddressList)
                                {
                                    <MudSelectItem Value="@item.AddressId">
                                        @( $"{item.AddressLine1}, {item.City}, {item.RegionDescription} ({item.PinCode}) | {item.Contact_Person}, Mob#{item.Mobile_Numbers}")
                                    </MudSelectItem>
                                }
                                @if (isFatched)
                                {
                                    <MudSelectItem Value="-1">
                                        Other
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>


                        <!-- Role Selection -->
                        <MudItem xs="12" md="12">
                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary">List of Line Items </MudChip>
                        </MudItem>
                        <MudItem xs="12" md="12">
                            <MudTable T="PODetails" Items="PO.Details" Hover="true" Dense="true" Bordered="true" Striped="true" SortLabel="Sort By">
                                <HeaderContent>
                                    <MudTh><MudTableSortLabel SortBy="new Func<PODetails, object>(x => x.LineItem)">LINE ITEM</MudTableSortLabel></MudTh>
                                    <MudTh Style="width:80px;"><MudTableSortLabel SortBy="new Func<PODetails, object>(x => x.Article)">ARTICLE</MudTableSortLabel></MudTh>
                                    <MudTh><MudTableSortLabel SortBy="new Func<PODetails, object>(x => x.ArticleDesc)">ARTICLE DESCRIPTION</MudTableSortLabel></MudTh>
                                    <MudTh><MudTableSortLabel SortBy="new Func<PODetails, object>(x => x.PrepackQty)">PREPACK QTY.</MudTableSortLabel></MudTh>
                                    <MudTh><MudTableSortLabel SortBy="new Func<PODetails, object>(x => x.PurchaseTotQty)">TOTAL QTY.</MudTableSortLabel></MudTh>
                                    <MudTh><MudTableSortLabel SortBy="new Func<PODetails, object>(x => x.PrepackQtyEaches)">PREPACK QTY. EACHES</MudTableSortLabel></MudTh>
                                    <MudTh><MudTableSortLabel SortBy="new Func<PODetails, object>(x => x.Eaches)">EACHES</MudTableSortLabel></MudTh>
                                    <MudTh><MudTableSortLabel SortBy="new Func<PODetails, object>(x => x.Eaches)">MRP</MudTableSortLabel></MudTh>
                                    @* <MudTh></MudTh> *@
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="LINE ITME">@context.LineItem</MudTd>
                                    <MudTd DataLabel="ARTICLE">@context.Article</MudTd>
                                    <MudTd DataLabel="DESCRIPTION">@context.ArticleDesc</MudTd>
                                    <MudTd DataLabel="TOTAL QTY.">@context.PrepackQty</MudTd>
                                    <MudTd DataLabel="TOTAL QTY.">@context.PurchaseTotQty</MudTd>
                                    <MudTd DataLabel="TOTAL QTY.">@context.PrepackQtyEaches</MudTd>
                                    <MudTd DataLabel="TOTAL QTY.">@context.Eaches</MudTd>
                                    <MudTd DataLabel="TOTAL QTY.">@context.MRP</MudTd>
                                    @*   <MudTd>
                                        <MudTooltip Text="Edit Details" ShowOnFocus="false">
                                            <MudIconButton Icon="@Icons.Material.Filled.ModeEdit" Color="Color.Secondary" Size="Size.Small"
                                                           OnClick="@(() => EditItem(context))" />
