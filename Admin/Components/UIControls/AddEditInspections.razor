        {
            <MudButton OnClick="Save" Color="Color.Secondary" Variant="Variant.Filled" Disabled="@isSubmitting">Save Request</MudButton>
            <MudButton OnClick="Reset" Color="Color.Warning" Variant="Variant.Filled">Reset</MudButton>
        }
        <MudButton OnClick="CancelRequest" Color="Color.Error" Variant="Variant.Outlined">Cancel Request</MudButton>
        <MudButton OnClick="CloseDialog" Color="Color.Error" Variant="Variant.Filled">Close</MudButton>
    </DialogActions>
</MudDialog>
<Loader IsVisible="@IsLoading" />

@code {
    [Inject] private IPoSyncService _poSyncService { get; set; } = default!;   // NEW
    [Inject] protected ICurrentUserService _CurrentUser { get; set; } = default!;
    [Inject] private PoResolver _poResolver { get; set; } = default!;
    bool isShow;
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }
    [Parameter]
    public POHeader PO { get; set; } = new();
    [Parameter] public bool IsEditMode { get; set; }
    public bool IsMaked { get; set; } = false;

    private bool isFatched { get; set; }

    private MudForm form;
    private bool isSubmitting = false;
    bool IsLoading = false;
    // private int User_Id = 0;
    // private string LoggedVendorCode = string.Empty;

    protected override async Task OnInitializedAsync()
    {

        try
        {
            // ✅ Guard : PO parameter null check
            if (PO == null)
            {
                // Snackbar.Add("Inspection data is missing.", Severity.Error);
                PO = new();
                isFatched = false;
            }
            else
            {
                isFatched = IsEditMode;
                tempQcAtDcValue = PO.Is_Qc_At_Dc;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error initializing page: {ex.Message}", Severity.Error);
        }

    }

    private async Task Reset()
    {
        bool? dres = await DialogService.ShowMessageBox("Confirmation", "Are you sure you want to reset the form ?", yesText: "  Yes!  ", cancelText: "   No   ");
        if (dres == null)
        {
            return;
        }
        else
        {
            PO = new();
            IsEditMode = false;
            isFatched = false;
            StateHasChanged();
        }
    }

    private async Task CancelRequest()
    {
        PO.IsCancelled = true;
        Save();
    }
    //Get_Roles_List
    private async void Save()
    {

        if (string.IsNullOrEmpty(PO.VendorCode))
        {
            await ShowErrorDialog("Validation", "Vendor Code & Vendor Name are required.");
            return;
        }
        if (PO.Details.Count == 0)
        {
            await ShowErrorDialog("Validation", "At least one line item is required.");
            return;
        }

        if (PO.OfferedQty <= 0)
        {
            await ShowErrorDialog("Validation", "Offered Qty. is required.");
            return;
        }
        if (PO.RegionId == 0)
        {
            await ShowErrorDialog("Validation", "Region is required.");
            return;
        }
        if (PO.AddressId <= 0)
        {
            await ShowErrorDialog("Validation", "Location is required.");
            return;
        }
        // if (PO.OfferedQty > (PO.POTotalQty * 1.10m))
        // {
        //     await ShowErrorDialog("Validation", "Offered quantity exceeds the allowed 10% additional limit of the total quantity.");
        //     return;
        // }



        bool? dres = await DialogService.ShowMessageBox("Confirmation", "Do you want to save Inspection details?", yesText: "  Yes!  ", cancelText: "   No   ");
        if (dres == null)
        {
            return;
        }
        else
        {
            await form.Validate();

            if (form.IsValid)
            {

                PO.CreatedBy =_CurrentUser.UserId;// Set the CREATED BY
                IsLoading = true;
                StateHasChanged();
                var res1 = await ApiMasterService.CallingAPI<GenRes, POHeader>(AllApiNames.SAVE_INSPECTION!, PO);
                IsLoading = false;
                StateHasChanged();
                if (res1.responseCode.Equals(0))
                {
                    var success = await InspectionNotifier.NotifyAsync(new InspectionCreatedModel(PO, res1.recordId));
                    Snackbar.Add(success ? "PO record saved successfully." : "PO record saved successfully but email not sent.", Severity.Success);
                    MudDialog?.Close();
                }
                else
                {
                    await ShowErrorDialog("Error!", res1.responseMessage!);
                }


            }
        }

    }
    
    private void CloseDialog()
    {
        MudDialog?.Close();
    }
    private async Task ShowErrorDialog(string Tital, string message)
    {
        await DialogService.ShowMessageBox(Tital, message);
    }
    // Find Button Logic
    private async Task OnFindClick()
    {
        if (string.IsNullOrEmpty(PO.PoNumber))
        {
            await ShowErrorDialog("Warning", "Please enter a valid PO Number");
            return;
        }

        var pno = PO.PoNumber;
        IsLoading = true;
        var result = await _poResolver.ResolveAsync(pno);
        IsLoading = false;

        if (!result.Found)
        {
            await ShowErrorDialog("Info", result.ErrorMessage ?? "PO not found.");
            PO = new();
            PO.PoNumber = pno;
            return;
        }
        // Ownership is checked first, so a vendor can never trigger a sync for another vendor's PO
        if (_CurrentUser.UserCode != result.PO!.VendorCode)
        {
            await ShowErrorDialog("Info", "This PO number is not assigned to you.");
            PO = new();
            PO.PoNumber = pno;
            return;
        }
        // NEW: the PO already exists in QPS - refresh it from SAP before a new request is raised (E5, E7, N1, N8, N10)
        if (result.Origin == Domain.Enums.DataOrigin.Local)
        {
            IsLoading = true; StateHasChanged();
            var sync = await _poSyncService.SyncAsync(result.PO, _CurrentUser.UserId);
            IsLoading = false; StateHasChanged();

            if (sync.Issue == PoSyncIssue.NotFoundInSap)
            {
                await ShowErrorDialog("Info", $"PO {pno} is no longer available in SAP (cancelled or closed). An inspection request cannot be raised.");
                PO = new();
                PO.PoNumber = pno;
                return;
            }

            if (sync.Issue == PoSyncIssue.VendorChanged)
            {
                // Generic text: never show another vendor's code to the vendor
                await ShowErrorDialog("Info", $"PO {pno} has been reassigned in SAP. Please contact the QA team.");
                PO = new();
                PO.PoNumber = pno;
                return;
            }

            if (!sync.Success)
                await ShowErrorDialog("Warning", "Latest PO details could not be fetched from SAP. The details already available in QPS will be used.");
        }
        PO = result.PO;

        if (result.Origin == Domain.Enums.DataOrigin.Local)
        {
            await ShowErrorDialog("Info", "PO details already exist.");

            if (result.PO.IsLastRequestPending == true)
            {
                await ShowErrorDialog("Info", "Last Inspection request is under process.");
                MudDialog?.Close();
                return;
            }
        }

        IsLoading = true; StateHasChanged();
        var vendorResult = await _vendorLookup.GetByCodeAsync(PO.VendorCode);
        IsLoading = false; StateHasChanged();
        if (vendorResult.Found)
        {
            foreach (var addrss in vendorResult.Vendor!.VendorAddresses)
                PO.AddressList.Add(mapper.Map<VendorAddressDetail>(addrss));
        }

        PO.RegionList = (await _fetchMasterList.FetchMasterList(CmdNames.Get_Region_With_QAM)).masterDataList;
        PO.InspectionTypeList = (await _fetchMasterList.FetchMasterList(CmdNames.Get_Inspection_Type, 0, PO.PoNumber)).masterDataList;

        isFatched = true;
    }
  
    private async void AddToAddressList()
    {
        await form.Validate();

        if (form.IsValid)
        {

        }
    }
    private async void EditItem(PODetails request)
    {

        var parameters = new DialogParameters
        {
            { "_vendor",  new Vendor()  },
            { "IsEditMode", false }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        var dialog = await DialogService.ShowAsync<POLineItemDetails>("PO Line Item Detials", parameters, options);

        var result = await dialog.Result;

    }

    private async Task OnLocationChanged(int newValue)
    {
        PO.AddressId = newValue;

        if (newValue == -1)  // If "Other" selected
        {
            var parameters = new DialogParameters
            {
                ["PO"] = PO // optional
            };

            var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Small,
                FullWidth = true
            };

            var dialog = DialogService.Show<AddNewAddressDialog>("Add New Address", parameters, options);
            var result = await dialog.Result;
            if (!result!.Canceled)
            {
                int addId = (int)result.Data;
                UpdateAddressList(addId);
            }
            StateHasChanged();
        }
    }
    private async void UpdateAddressList(int addId)
    {
        IsLoading = true; StateHasChanged();
        var result = await _vendorLookup.GetByCodeAsync(PO.VendorCode);
        IsLoading = false; StateHasChanged();
        if (result.Found)
        {
            PO.AddressId = addId;
            PO.AddressList.Clear();
            foreach (var addrss in result.Vendor!.VendorAddresses)
            {
                PO.AddressList.Add(mapper.Map<VendorAddressDetail>(addrss));
            }
            StateHasChanged();
        }
    }

    private bool tempQcAtDcValue;

    private async Task OnQcAtDcChanged(bool newValue)
    {
        if (newValue)
        {
            bool? confirmed = await DialogService.ShowMessageBox(
                "Confirm Inspection Location",
                "You're about to raise this inspection request as QC at DC (Quality Check at Distribution Center)." +
                " The inspection will be carried out at the Distribution Center, not at your factory/warehouse." +
                " Please ensure goods are dispatched to the DC before the inspection date." +
                " This setting cannot be changed after submission." +
                " Do you want to continue with QC at DC?",
                yesText: "Yes, Continue",
                cancelText: "No, Cancel");

            if (confirmed == true)
            {
                PO.Is_Qc_At_Dc = true;
                tempQcAtDcValue = true;
            }
            else
            {
                PO.Is_Qc_At_Dc = false;
                tempQcAtDcValue = false;
            }
        }
        else
        {
            PO.Is_Qc_At_Dc = false;
            tempQcAtDcValue = false;
        }
    }
}
