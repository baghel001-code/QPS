    [Parameter] public bool IsEditMode { get; set; }

    private VendorAuditFormModel _model = new();
    private MudForm _form = new();
    private string[] _formErrors = Array.Empty<string>();
    private bool _isSubmitting = false;
    private bool _gstLoading = false;
    private bool isFatched { get; set; }
   
    private string gstPattern = @"^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$";
    List<AuditChecklistItem> CheckListMaster = new();
    // ─── Lifecycle ────────────────────────────────────────────────
    protected async override Task OnInitializedAsync()
    {
        try
        {
            //Model parameter null check
            if (ExistingModel == null)
            {
                Snackbar.Add("Audit data is missing.", Severity.Error);
                _model = new();
                isFatched = false;
            }
            else
            {
                isFatched = IsEditMode;
                _model = ExistingModel;
            }
            await GetAllMasters();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading audit form: {ex.Message}", Severity.Error);
            MudDialog?.Close();
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task GetAllMasters()
    {
        try
        {
            var yesNoMaster = await GetMasterData(CmdNames.Get_YesNo) ?? new List<MasterData>();
            var businessHeadMaster = await GetMasterData(CmdNames.Get_BUSINESS_HEAD) ?? new List<MasterData>();
            var auditCheckList = await GetMasterData(CmdNames.GET_AUDTI_CHECKLIST) ?? new List<MasterData>();
            _model.BusinessHeadList = businessHeadMaster;
            int sno = 1;
            foreach (var item in auditCheckList)
            {
                CheckListMaster.Add(new() { CheckListMasterId = item.Master_ID, SrNo = sno, Description = item.Master_Name, StatusList = yesNoMaster });
                sno++;
            }

            if (ExistingModel != null)
            {
                var bLookup = ExistingModel.Checklist.ToDictionary(b => b.CheckListMasterId);

                foreach (var itemA in CheckListMaster)
                {
                    if (bLookup.TryGetValue(itemA.CheckListMasterId, out var match))
                    {
                        itemA.Status = match.Status;
                        itemA.ValidityDate = match.ValidityDate;
                        itemA.Remarks = match.Remarks;
                        itemA.Attachments = match.Attachments;
                    }
                }
            }

            _model.BusinessHeadList = businessHeadMaster;
            _model.Checklist = CheckListMaster;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading master data: {ex.Message}", Severity.Error);
        }
    }
    private async Task<List<MasterData>> GetMasterData(string cmd)
    {
        try
        {
            IsLoading = true;
            var result = await _fetchMasterList.FetchMasterList(cmd);
            IsLoading = false;

            return result?.masterDataList ?? new List<MasterData>();
        }
        catch (Exception ex)
        {
            IsLoading = false;
            Snackbar.Add($"Error loading {cmd} data: {ex.Message}", Severity.Error);
            return new List<MasterData>(); // ✅ Never return null 
        }
    }
    // ─── GST Lookup ───────────────────────────────────────────────
    private async Task LookupGst()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(_model.GstNumber) || _model.GstNumber.Length != 15)
            {
                Snackbar.Add("Please enter a valid 15-digit GST number.", Severity.Warning);
                return;
            }
            if (!Regex.IsMatch(_model.GstNumber.ToUpper(), gstPattern))
            {
                Snackbar.Add("Please enter a valid GST number.", Severity.Warning);
                return;

            }

            _gstLoading = true;
            await InvokeAsync(StateHasChanged);

            // Prepare request safely
            var selectRequest = new SelectListReq
            {
                Id = 0,
                Cmd = CmdNames.Get_GST_Details,
                StrField = _model.GstNumber      // null-safe
            };


            var existingGST = await ApiMasterService.CallingAPI<GSTINLocalDBResponse, SelectListReq>(AllApiNames.GET_GST_DETAILS, selectRequest);


            if (existingGST.responseCode == 0 && existingGST.responseMessage!.ToUpper() == "SUCCESS")
            {

                if (!string.IsNullOrEmpty(existingGST.VENDOR_NAME) && !string.IsNullOrEmpty(existingGST.REGISTERED_ADDRESS))
                {

                    await ShowErrorDialog("Info", "GST details already exist.");

                    _model.VendorName = existingGST.VENDOR_NAME;
                    _model.RegisteredAddress = existingGST.REGISTERED_ADDRESS;
                    _model.GSTApiResponse = existingGST.GST_API_RAW_RESPONSE;

                    return;
                    //-------------------------
                }
            }

            // ✅ Call your GST API here
            var req = new SAP_API_DATA_Req
            {
                Param = _model.GstNumber,  // Ensure no null 09ABKCS6285P1Z8   03AFLPM9444GIZA
                TaskName = "ALL_CLEAR_TAX"
            };

            //IsLoading = true;
            var gstApiData = await ApiMasterService.CallingAPI<ApiData, SAP_API_DATA_Req>(AllApiNames.GET_SAP_API!, req).ConfigureAwait(false);
            //IsLoading = false;

            if (gstApiData is not null)
            {
                // IsLoading = true;
                var GSTDetails = await ApiMasterService.CallingGSTAPI<GSTINResponse, string>(string.Empty, gstApiData).ConfigureAwait(false);
                // IsLoading = false;
                if (GSTDetails != null)
                {
                    if (GSTDetails.responseCode == 0 && GSTDetails.responseMessage?.ToUpper() == "SUCCESS")  // Safe and concise
                    {
                        if (!string.IsNullOrEmpty(GSTDetails.TradeName))
                        {
                            _model.VendorName = GSTDetails.TradeName;
                            _model.RegisteredAddress = GSTDetails.PrincipalAddress.AddressDetail.FullAddress;
                            _model.GSTApiResponse = JsonConvert.SerializeObject(GSTDetails, Formatting.Indented);

                            await Task.Delay(500);
                            Snackbar.Add("GST lookup completed.", Severity.Success);
                        }
                    }
                    else
                    {
                        if (GSTDetails.responseCode == 1004)
                        {
                            Snackbar.Add("GST Details not found.", Severity.Warning);
                        }
                        else
                        {
                            Snackbar.Add(GSTDetails.responseMessage, Severity.Error, config =>
                                {
                                    config.VisibleStateDuration = 2000;
                                });
                        }
                    }
                }
                else
                {
                    Snackbar.Add("GST Details not found.", Severity.Warning);
                }
            }
            else
            {
                Snackbar.Add("GST Api not found", Severity.Error);
                return;
            }


            // ── Simulate for now ──────────────────────────────────

        }
        catch (Exception ex)
        {
            Snackbar.Add($"GST lookup failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _gstLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string ValidateGST(string gst)
    {
        if (string.IsNullOrWhiteSpace(gst))
            return "GST Number is required";

        return Regex.IsMatch(gst.ToUpper(), gstPattern) ? "" : "Invalid GST Number";
    }

    // ─── Save (partial save) ──────────────────────────────────────
    private async Task Save()
    {
        // ── Validate FIRST before any disk operation ───────────────────────
        if (_isSubmitting)
        {
            Snackbar.Add("Cannot save : Audit is already submitted.", Severity.Warning);
            return;
        }

        bool? dres = await DialogService.ShowMessageBox("Confirmation", "Do you want to save Audit details?", yesText: "  Yes!  ", cancelText: "   No   ");
        if (dres == null)
        {
            return;
        }
        else
        {

            await _form.Validate();
            if (!_form.IsValid)
            {
                var html = "<ul style='margin:0; padding-left:16px;'>" + string.Concat(_form.Errors.Select(e => $"<li>{e}</li>")) + "</ul>";

                Snackbar.Add((MarkupString)html, Severity.Error, options =>
                {
                    options.RequireInteraction = true;   // stays until user closes
                });

                return;
            }

            if (_form.IsValid)
            {
                _isSubmitting = true;
                try
                {
                    // Save any pending in-memory files to disk and stamp AttachmentPath
                    foreach (var att in _model.Checklist)
                    {
                        var cardFiles = GetFiles(att);
                        if (!cardFiles.Any()) continue; // ← no new uploads, keep existing DB path as-is

                        // ── Delete old files from disk before saving new ones ──────────────
                        if (!string.IsNullOrEmpty(att.Attachments))
                        {
                            DeleteFilesFromDisk(att.Attachments);
                            att.Attachments = string.Empty; // clear old paths
                        }

                        var savedPaths = new List<string>();

                        // Preserve existing paths if any
                        if (!string.IsNullOrEmpty(att.Attachments))
                        {
                            savedPaths.AddRange(
                                att.Attachments.Split(',', StringSplitOptions.RemoveEmptyEntries)
                            );
                        }
                        // Add newly uploaded files
                        foreach (var file in cardFiles)
                        {
                            var savedPath = await PersistFileToDisk(file);
                            if (!string.IsNullOrEmpty(savedPath))
                                savedPaths.Add(savedPath);
                        }

                        if (savedPaths.Any())
                            att.Attachments = string.Join(",", savedPaths);

                    }

                    _model.RequestedBuyerName = _CurrentUser.UserCode;
                    _model.UserId = _CurrentUser.UserId;

                    var res = await ApiMasterService.CallingAPI<GenRes, VendorAuditFormModel>(AllApiNames.ADD_EDIT_AUDIT_REQUEST!, _model);
                    if (res.responseCode == 0)
                        Snackbar.Add("saved successfully.", Severity.Success);
                    else
                    {
                         Snackbar.Add($"Save failed: {res.responseMessage}", Severity.Error);
                         Logger.LogInformation(res.responseMessage);
                    }
                    MudDialog?.Close(DialogResult.Ok(true));

                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
                    Logger.LogError(ex, $"Save failed");
                }
                finally
                {
                    _isSubmitting = false;
                }
            }
        }
    }

