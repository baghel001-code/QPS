@inherits QpsPageBase
@page "/QALocationMasterDialog"
@using Admin.Components.Pages.UserMaster
@using Admin.Components.Shared
@using Admin.Components.UIControls.BaseComponents
@using Application.Interfaces.V1.User
@using MudExtensions
<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudGrid>
                <MudItem xs="12" md="9">
                    <MudGrid>
                        <!-- Employee Code -->
                        <MudItem xs="12" md="6">
                            @if (IsEditMode)
                            {
                                <MudTextField T="string" Label="Employee Code" ReadOnly="true" @bind-Value="User.Emp_Code" Required="true" />
                            }
                            else
                            {
                                <MudGrid>
                                    <MudItem xs="12">
                                        <MudTextField T="string" Label="Employee Code" @bind-Value="User.Emp_Code" Required="true" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.PersonSearch" AdornmentColor="Color.Secondary" OnAdornmentClick="@(() => OnFindClick())" />
                                    </MudItem>
                                </MudGrid>
                            }
                        </MudItem>
                        <!-- Employee Name -->
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Employee Name" ReadOnly="true" @bind-Value="User.Emp_Name" Required="true" />
                        </MudItem>
                        <!-- Other fields here, similar to the example -->
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Employee Location" ReadOnly="true" @bind-Value="User.Emp_Location" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Employee Location Code" ReadOnly="true" @bind-Value="User.Emp_Loc_Code" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Department Name" ReadOnly="true" @bind-Value="User.Emp_Dept_Name" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Designation" ReadOnly="true" @bind-Value="User.Emp_Desig" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Contact No" ReadOnly="true" @bind-Value="User.Emp_Contact_No" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Email Id" ReadOnly="true" @bind-Value="User.Emp_Mail_Id" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Reporting Manager" ReadOnly="true" @bind-Value="User.Emp_Rpt_Mng" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSwitch T="bool" Label="Is Resigned?" @bind-Value="User.Is_Resign" Color="Color.Secondary" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" Label="Employee Grade Description" ReadOnly="true" @bind-Value="User.Emp_Grade_Desc" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSwitch T="bool" Label="Is Active?" @bind-Value="User.Emp_Status" Color="Color.Secondary" />
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudGrid>
                        <!-- Role Selection -->
                        <MudItem xs="12" md="12">
                            <MudSelect T="string" Label="Select Location" AnchorOrigin="Origin.BottomLeft" Clearable Variant="Variant.Text" @bind-Value="User.REGION_IDS" Required="true">
                                @foreach (var rgn in User!.RegionList)
                                {
                                    <MudSelectItem T="string" Value="rgn.Master_ID.ToString()">@rgn.Master_Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="12">
                            <MudTextField Label="Stamp No" @bind-Value="User.StampNo" />
                        </MudItem>
                        <MudItem xs="12" md="12">
                            <SignatureUpload UserId="User.Id" SignatureBytes="User.SignatureBytes" OnSignatureSaved="HandleSignatureSaved" />
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Save" Color="Color.Secondary" Variant="Variant.Filled" Disabled="@isSubmitting">Save</MudButton>
        <MudButton OnClick="CloseDialog" Color="Color.Error" Variant="Variant.Filled">Cancel</MudButton>
    </DialogActions>
</MudDialog>
<Loader IsVisible="@IsLoading" />

@code {
    [Inject] private IUserDirectoryService UserDirectoryService { get; set; } = default!;
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public UserDetails User { get; set; }
    [Parameter] public bool IsEditMode { get; set; }
    private MudForm form;
    private bool isSubmitting = false;
    private SelectListReq selectListReq = new();
    private HrpLoginByCodeReq hrpLoginByCodeReq = new();
    bool IsLoading = false;

    //Get_Roles_List
    private async void Save()
    {
        await form.Validate();
        if (form.IsValid)
        {
            bool? dres = await DialogService.ShowMessageBox("Confirmation", User.Id == 0 ? "Are you sure you want to save?" : "Are you sure you want to update this user?", yesText: "  Yes!  ", cancelText: "   No   ");
            if (dres == null)
            {
                return;
            }
            else
            {
                MudDialog?.Close(DialogResult.Ok(User));
            }
        }
    }

    private void CloseDialog()
    {
        MudDialog?.Close();
    }

    private async Task ShowErrorDialog(string Tital, string message)
    {
        await DialogService.ShowMessageBox(Tital, message);
    }

    private async Task OnFindClick()
    {
        if (string.IsNullOrEmpty(User.Emp_Code))
        {
            await ShowErrorDialog("Warning", "Please enter a valid Emp Code.");
            return;
        }

        var rgnlist = User.RegionList;

        try
        {
            var result = await UserDirectoryService.FindUserByEmpCodeAsync(User.Emp_Code);

            if (!result.Success)
            {
                await ShowErrorDialog("Error", result.ErrorMessage ?? "Failed to look up user.");
                return;
            }

            User = result.Found ? result.User : new UserDetails();
            if (!result.Found)
            {
                await ShowErrorDialog("Warning", "User not found.");
            }
        }
        catch (Exception ex)
        {
            await ShowErrorDialog("Error", $"An unexpected error occurred: {ex.Message}");
        }
        finally
        {
            User.RegionList = rgnlist;
        }
    }

    private async Task HandleSignatureSaved(byte[] signatureBytes)
    {
        User.SignatureBytes = signatureBytes;
        await Task.CompletedTask;
    }

}
