<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
		<Version>2.0.4</Version>
		<AssemblyVersion>2.0.4</AssemblyVersion>
		<FileVersion>2.0.4</FileVersion>
	</PropertyGroup>
	<ItemGroup>
		<None Include="Fonts\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Fonts\ALGER.TTF" />
		<Content Include="Fonts\arial.ttf" />
		<Content Include="Fonts\arialbd.ttf" />
		<Content Include="Fonts\arialbi.ttf" />
		<Content Include="Fonts\ariali.ttf" />
		<Content Include="Fonts\ARIALN.TTF" />
		<Content Include="Fonts\ARIALNB.TTF" />
		<Content Include="Fonts\ARIALNBI.TTF" />
		<Content Include="Fonts\ARIALNI.TTF" />
		<Content Include="Fonts\ariblk.ttf" />

	</ItemGroup>
	<ItemGroup>
		<Content Include="Logs\**" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="ReportViewerCore.NETCore" Version="15.1.26" />
		<PackageReference Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Application\Application.csproj" />
		<ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="MyNewEncDec">
			<HintPath>..\Dependencies\MyNewEncDec\MyNewEncDec.dll</HintPath>
		</Reference>
	</ItemGroup>

</Project>
